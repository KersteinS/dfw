    try:
        with open(DFW_CONFIG_PATH, "r") as conf:
            return conf.read()
    except FileNotFoundError:
        log(f"config file does not exist at {DFW_CONFIG_PATH}. Making a new, blank config file.", level=INFO)
        write_config(Config.default_config)
        return Config.default_config

def make_fresh_rules_file(default_in="deny", default_out="allow") -> int:
    content = (
        f"# generated by {PROGRAM_NAME} version {VERSION}. Default incoming={default_in}. Default outgoing={default_out}.\n\n"
        + (f"{RULES_HEAD_ALLOW_OUT}\n" if default_out=="allow" else f"{RULES_HEAD_DENY_OUT}\n")
        + (f"\n\n{RULES_TAIL_DENY_IN}\n" if default_in=="deny" else f"\n\n{RULES_TAIL_ALLOW_IN}\n")
    )
    with open(DFW_RULES_PATH, "w") as rules_file:
