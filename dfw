def log(*args, level=INFO, **kwargs):
    if level >= LOG_LEVEL:
        print(*args, **kwargs)

def write_config(config: str | Config): # I can think of no case where I need to check for this failing. It should always succeed. PermissionError? I already check euid and verify/create the config at program startup...
    if isinstance(config, str):
        with open(DFW_CONFIG_PATH, "w") as conf:
