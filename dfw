def configure_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM_NAME, description="CLI tool accepting ufw-like commands to modify ufw's after.rules file to support adding firewall rules that docker will respect.")
    parser.add_argument("-d", "--dry-run", action="store_true", help="Run using given input without making any change to the system. This also attempts to test the provided command for validity.")
    parser.add_argument("-v", "--verbose", action="count", default=0, help="Enable verbose logging (repeat up to 3x for increased verbosity).")
    parser.add_argument("-s", "--suppress", action="count", default=0, help="Suppress error messages (repeat up to 2x to suppress all messages")
    parser.add_argument("-V", "--version", action="version", version=get_version_string())

    subparsers = parser.add_subparsers(dest="command", required=True, help="Provide the command to run")

    enable_parser = subparsers.add_parser("enable", help="Adds previously defined rules to ufw's after.rules file.")
    enable_parser.set_defaults(func=enable_func)

    disable_parser = subparsers.add_parser("disable", help=f"Removes all rules added by {PROGRAM_NAME} from ufw's after.rules file.")
    disable_parser.set_defaults(func=disable_func)

    default_parser = subparsers.add_parser("default", help="")
    default_parser.set_defaults(func=default_func)

    logging_parser = subparsers.add_parser("logging", help="") # may be redundant with --verbose?
    logging_parser.set_defaults(func=logging_func)

    rule_parser = subparsers.add_parser("rule", help=f"Add a rule {PROGRAM_NAME}.")
    rule_parser.set_defaults(func=rule_func)

    allow_parser = subparsers.add_parser("allow", help=f"Adds an allow rule to ufw's after.rules file.")
    allow_parser.set_defaults(func=rule_func)

    deny_parser = subparsers.add_parser("deny", help="Adds a deny rule to ufw's after.rules file.")
    deny_parser.set_defaults(func=rule_func)

    reject_parser = subparsers.add_parser("reject", help="Adds a reject rule to ufw's after.rules file.")
    reject_parser.set_defaults(func=rule_func)

    limit_parser = subparsers.add_parser("limit", help="Adds a limit rule to ufw's after.rules file.")
    limit_parser.set_defaults(func=rule_func)

    delete_parser = subparsers.add_parser("delete", help="Deletes the specified rule from ufw's after.rules file.")
    delete_parser.set_defaults(func=rule_func)

    insert_parser = subparsers.add_parser("insert", help="")
    insert_parser.set_defaults(func=rule_func)

    prepend_parser = subparsers.add_parser("prepend", help="")
    prepend_parser.set_defaults(func=rule_func)

    reload_parser = subparsers.add_parser("reload", help=f"Removes and re-adds all {PROGRAM_NAME}-added rules from/to ufw's after.rules file, then reloads ufw.")
    reload_parser.set_defaults(func=reload_func)

    reset_parser = subparsers.add_parser("reset", help="")
    reset_parser.set_defaults(func=reset_func)

    status_parser = subparsers.add_parser("status", help=f"Prints all {PROGRAM_NAME}-added rules. Use {PROGRAM_NAME} status --help for more options.")
    status_parser.set_defaults(func=status_func)
    status_parser_subparsers = status_parser.add_subparsers(dest="", required=False)
    status_numbered_parser = status_parser_subparsers.add_parser("numbered", help=f"Prints all {PROGRAM_NAME}-added rules as a numbered list.")
    status_numbered_parser.set_defaults(func=status_numbered_func)
    status_verbose_parser = status_parser_subparsers.add_parser("verbose", help=f"Prints all {PROGRAM_NAME}-added rules with additional details.")
    status_verbose_parser.set_defaults(func=status_verbose_func)

    show_parser = subparsers.add_parser("show", help="")
    show_parser.set_defaults(func=show_func)

    version_parser = subparsers.add_parser("version", help=f"Print {PROGRAM_NAME} version info.")
    version_parser.set_defaults(func=version_func)

    return parser

def docker_user_chain_exists():
    try:
        result = subprocess.run(["iptables", "-L", "DOCKER-USER", "-n"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return result.returncode == 0
    except FileNotFoundError:
        return False

def confirm_root_and_chain() -> int:
    if os.geteuid() != 0:
        log("You need to be root to run this script", level=CRITICAL)
        return NOT_ROOT
    if not docker_user_chain_exists():
        log(f"The {CHAIN} chain does not exist in iptables, the iptables command doesn't exist, or you don't have permission to use iptables. Ensure iptables and docker are correctly configured on your system.", level=CRITICAL)
        return IPTABLES_ERROR
    return 0

def main():
    parser = configure_parser()
    args,remainder = parser.parse_known_args()
    global LOG_LEVEL
    if args.verbose >= 3:
        LOG_LEVEL = TRACE
    elif args.verbose == 2:
        LOG_LEVEL = DEBUG
    elif args.verbose == 1:
        LOG_LEVEL = INFO
    elif args.suppress == 1:
        LOG_LEVEL = ERROR
    elif args.suppress >= 2:
        LOG_LEVEL = CRITICAL
    else:
        LOG_LEVEL = WARNING
    log(*sys.argv, level=DEBUG)
    DEFAULT_IFACE = get_default_interface()
    try:
        args.config = Config.parse_config_str(read_config())
    except ValueError as e:
        log(f"ERROR: {e}", level=CRITICAL)
        sys.exit(CONFIG_INVALID)
    if not os.path.exists(DFW_RULES_PATH):
        log(f"{DFW_RULES_PATH} doesn't exist. Creating default rules file.", level=WARNING)
        make_fresh_rules_file(args.config.default_in, args.config.default_out)
    sys.exit(args.func(args, remainder))

if __name__ == "__main__":
    main()
