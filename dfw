    #    description=Some description
    #    ports=12/udp|34|56,78:90/tcp
    # members for simple syntax:
    # verb = allow|deny|reject|limit (required)
    # direction = in|out (optional, default in
    # log =  log|log-all (optional, if not provided, no specific logging for this rule is enabled. Note that global logging rules are applied seperately)
    # port_and_proto = [ PORT[/PROTOCOL] | APPNAME ] (port at least is required, proto is optional and if not provided will allow both tcp and udp. Alternatively, an app name can be provided. If ufw is installed, dfw will use ufw's app definitions, otherwise, it will fallback to a dfw app definitions file)
    # comment = a string comment (optional, unused if not provided. Length is limited to 256 - len(RULE_COMMENT)-1 and will be prepended with RULE_COMMENT)

    # members for advanced syntax:
    # verb
    # direction 
    # interface = valid network interface on system (ls /sys/class/net/ must be defined after direction and prefix with "on" keyword)
    # log
    # protocol = tcp|udp (optional, will be create a rule for both tcp and udp if ommitted)
    # from_address = ip address to [verb] (optional, must be prepended by "from" keyword if used)
    # from_port (port provided with from_address, can be substituted with an app name)
    # to_address = ip address to [verb] (optional, must be provided by "to" keyword if used)
    # to_port (port provided with to_address, can be substited with the "app" keyword and an app name)
    # app = app APPNAME (can be used instead of "port" keyword and a port)
    # comment

    @classmethod
    def read(cls, line: str):
        # This takes an iptre script line and parses it into a Rule instance
        return cls(line, "")
    
    @classmethod
    def interpret(cls, command: str):
        # This takes a dfw command (e.g. dfw allow 8080) and parses it into a Rule instance
        return cls("", command)

    def print_rule(self):
        pass

    def push(self) -> int:
        # This makes sends the Rule to iptables.
        cmd = ["iptables"] # need to construct the command based on defined members created in interpret or read
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, check=True)
            return result.returncode
        except subprocess.CalledProcessError as e:
            log(f"Command failed: {' '.join(cmd)}\nError: {e.stderr}", CRITICAL)
            return IPTABLES_ERROR
            

