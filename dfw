def write_config(config: str | Config): # must have already checked euid before calling
    if isinstance(config, str):
        with open(DFW_CONFIG_PATH, "w") as conf:
            conf.write(config)
    else:
        config_str = config.print_updated_config()
        with open(DFW_CONFIG_PATH, "w") as conf:
            conf.write(config_str)
    log("Wrote to dfw.conf.", level=INFO)

def read_config() -> str: # guaranteed to exist by start of main func
    with open(DFW_CONFIG_PATH, "r") as conf:
        return conf.read()

def make_default_rules(default_in: str, default_out: str, logging_level: str, ipv6_subnet="") -> (list[str],list[str]):
    # Log level low (all with rate limiting):
        # deny/reject in | allow out:
            # (A) incoming and outgoing packets matched by log-ed rules, and (B) packets that are being dropped/rejected due to the deny/reject-in policy. Allow-ed packets are only logged if they match the first criteria (match a log-ed rule)
                ## (A) is achieved in print_rule_ipt
                ## (B) is achieved by putting a jump to the DFW-LOG-DENY chain immediately before the rule: -A DOCKER-USER -i {DEFAULT_IFACE} -m conntrack --ctdir ORIGINAL -j DROP (or REJECT). That rule represents the default policy of deny/reject incoming. The criteria of the jump must match the criteria of the subsequent DROP/REJECT rule.
        # deny/reject in | deny/reject out:
            # (A) incoming and outgoing packets matched by log-ed rules, and (B) packets that are being dropped/rejected due to the deny/reject-in or deny/reject-out policies. Allow-ed packets are only logged if they match the first criteria (match a log-ed rule)
                ## (A) is achieved in print_rule_ipt
                ## (B) is achieved by putting a jump to the DFW-LOG-DENY chain immediately before the rule: -A DOCKER-USER -i {DEFAULT_IFACE} -m conntrack --ctdir ORIGINAL -j DROP (or REJECT); and putting a jump to DFW-LOG-DENY immediately before the rule: -A DOCKER-USER -s 172.17.0.0/12 -m conntrack --ctdir ORIGINAL -j DROP (or REJECT). Those rules represent the default policies of deny/reject incoming and deny/reject outgoing. The criteria of the jumps must match the criteria of their respective subsequent DROP/REJECT rules.
        # allow in | allow out:
            # (A) incoming and outgoing packets matched by log-ed rules. No packets are dropped/rejected due to default policy
                ## (A) is achieved in print_rule_ipt
        # allow in | deny/reject out:
            # (A) incoming and outgoing packets matched by log-ed rules, and (B) packets that being dropped/rejected due to the deny/reject-out policy. Allow-ed packets are only logged if they match the first criteria (match a log-ed rule)
                ## (A) is achieved in print_rule_ipt
                ## (B) is achieved by putting a jump to the DFW-LOG-DENY chain immediately before the rule: -A DOCKER-USER -s 172.17.0.0/12 -m conntrack --ctdir ORIGINAL -j DROP (or REJECT). That rule represents the default policy of deny/reject outgoing. The criteria of the jump must match the criteria of the subsequent DROP/REJECT rule.
    # Log level medium (all with rate limiting):
        # deny/reject in | allow out:
            # (A) incoming and outgoing packets matched by log-ed rules, (B) incoming packets that are being dropped/rejected only due to the deny/reject-in policy,
            # (C) incoming and outgoing packets that are NEW or INVALID, and (D) outgoing packets that are only allow-ed due to the allow-out policy (practical note, medium never logs established/related packets due to D).
                ## (A) and (B) refer to low rules for this default policy set.
                ## (C) is achieved by putting a jump to the DFW-LOG-DENY chain immediately before the rule: -A DOCKER-USER -m conntrack --ctstate INVALID -j DROP, and putting a jump to the DFW-LOG-ALLOW chain immediately before the rule: -A DOCKER-USER -s 172.17.0.0/12 -m conntrack --ctdir ORIGINAL -j RETURN (i.e. default policy allow out). The criteria of the jump to the DFW-LOG-DENY must match the criteria of the subsequent DROP rule. The criteria of the jump to the DFW-LOG-ALLOW chain must match the criteria of the subsequent RETURN rule and require ctstate to be NEW.
                ## (D) is achieved implicitly by (C)
        # deny/reject in | deny/reject out:
            # (A) incoming and outgoing packets matched by log-ed rules, (B) incoming and outgoing packets that are being dropped only due to the deny/reject-in and deny/reject-out policies, and
            # (C) incoming and outgoing packets that are NEW or INVALID.
                ## (A) and (B) refer to low rules for this default policy set.
                ## (C) is achieved by putting a jump to the DFW-LOG-DENY chain immediately before the rule: -A DOCKER-USER -m conntrack --ctstate INVALID -j DROP. The criteria of the jump to the DFW-LOG-DENY must match the criteria of the subsequent DROP rule.
        # allow in | allow out:
            # (A) incoming and outgoing packets matched by log-ed rules,
            # (C) incoming and outgoing packets that are NEW or INVALID, and (D) incoming and outgoing packets that are being allow-ed only due to the allow-in and allow-out policies (practical note, medium never logs established/related packets due to D).
                ## (A) refer to low rules for this default policy set.
                ## (C) is achieved by putting a jump to the DFW-LOG-DENY chain immediately before the rule: -A DOCKER-USER -m conntrack --ctstate INVALID -j DROP, putting a jump to the DFW-LOG-ALLOW chain immediately before the rule: -A DOCKER-USER -i {DEFAULT_IFACE} -m conntrack --ctdir ORIGINAL -j RETURN (i.e. default policy allow in), and putting a jump to the DFW-LOG-ALLOW chain immediately before the rule: -A DOCKER-USER -s 172.17.0.0/12 -m conntrack --ctdir ORIGINAL -j RETURN (i.e. default policy allow out). The criteria of the jump to DFW-LOG-DENY must match the criteria of the subsequent DROP rule. The criteria of the jumps to the DFW-LOG-ALLOW chain must match the criteria of the respective subsequent RETURN rules and require ctstate for both log rules to be NEW.
                ## (D) is achieved implicitly by (C)
        # allow in | deny/reject out:
            # (A) incoming and outgoing packets matched by log-ed rules, (B) outgoing packets that are only dropped/rejected due to the deny/reject-out policy,
            # (C) incoming and outgoing packets that are NEW or INVALID, and (D) incoming packets that are being allow-ed only due to the allow-in policy.
                ## (A) and (B) refer to low rules for this default policy set.
                ## (C) is achieved by putting a jump to the DFW-LOG-DENY chain immediately before the rule: -A DOCKER-USER -m conntrack --ctstate INVALID -j DROP, and putting a jump to the DFW-LOG-ALLOW chain immediately before the rule: -A DOCKER-USER -i {DEFAULT_IFACE} -m conntrack --ctdir ORIGINAL -j RETURN (i.e. default policy allow in). The criteria of the jump to the DFW-LOG-DENY must match the criteria of the subsequent DROP rule. The criteria of the jump to the DFW-LOG-ALLOW chain must match the criteria of the subsequent RETURN rule and require ctstate to be NEW.
                ## (D) is achieved implicitly by (C)
    # Log level high (same as medium with no rate limits plus other packets that have triggered rate limiting)
    # ufw log level high logs every packet except: any packet that has state ESTABLISHED/RELATED and any packet that matches a user defined rule that does not have log or log-all in the definition
    # Log level full (all packets in DOCKER-USER chain are logged without rate limiting). This is achieved by adding logging to ESTABLISHED,RELATED packets and adding logging companion rules to any un-log-ed dfw rules.
    top_rules = []
    bottom_rules = []
    top_rules.append(f"-A {CHAIN} -m conntrack --ctstate INVALID -j DROP {RULE_COMMENT}") # always drop invalid packets
    top_rules.append(f"-A {CHAIN} -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN {RULE_COMMENT}") # always allow existing connections and return immediately.
    if logging_level in ("low", "medium", "high", "full"): # add "low" logs
        top_rules.insert(0, f"-N {LOG_CHAIN_LIMIT} {RULE_COMMENT}")
        top_rules.insert(1, f"-A {LOG_CHAIN_LIMIT} -j LOG --log-prefix {LOG_PREFIX_LIMIT} --log-level 4 {RULE_COMMENT}")
        top_rules.insert(0, f"-N {LOG_CHAIN_DENY} {RULE_COMMENT}")
        top_rules.insert(1, f"-A {LOG_CHAIN_DENY} -j LOG --log-prefix {LOG_PREFIX_BLOCK} --log-level 4 {RULE_COMMENT}")
        top_rules.insert(0, f"-N {LOG_CHAIN_ALLOW} {RULE_COMMENT}")
        top_rules.insert(1, f"-A {LOG_CHAIN_ALLOW} -j LOG --log-prefix {LOG_PREFIX_ALLOW} --log-level 4 {RULE_COMMENT}")
        if default_in in ("deny", "reject"):
            bottom_rules.append(f"-A {CHAIN} -i {DEFAULT_IFACE} -m conntrack --ctdir ORIGINAL{' -m limit --limit 3/min --limit-burst 10' if logging_level in ('low','medium') else ''} -j {LOG_CHAIN_DENY} {RULE_COMMENT}") # log packets denied due to the default deny/reject-in policy
        if default_out in ("deny","reject"):
            bottom_rules.append(f"-A {CHAIN} -s {'172.17.0.0/12' if not ipv6_subnet else ipv6_subnet} -m conntrack --ctdir ORIGINAL{' -m limit --limit 3/min --limit-burst 10' if logging_level in ('low','medium') else ''} -j {LOG_CHAIN_DENY} {RULE_COMMENT}") # log packets denied due to the default deny-out policy
            bottom_rules.append(f"-A {CHAIN} -o docker0 -m conntrack --ctdir ORIGINAL{' -m limit --limit 3/min --limit-burst 10' if logging_level in ('low','medium') else ''} -j {LOG_CHAIN_DENY} {RULE_COMMENT}") # log packets denied due to the default deny/reject-out policy
    if logging_level in ("medium", "high", "full"): # add "medium" logs
        # At this point top_rules is: (0) CREATE_LOG_ALLOW_CHAIN, (1) POPULATE_LOG_ALLOW_CHAIN, (2) CREATE_LOG_DENY_CHAIN, (3) POPULATE_LOG_DENY_CHAIN (4) DROP_INVALID, (5) RETURN_ESTABLISH/RELATED
        top_rules.insert(4, f"-A {CHAIN} -m conntrack --ctstate INVALID{' -m limit --limit 3/min --limit-burst 10' if logging_level=='medium' else ''} -j {LOG_CHAIN_DENY} {RULE_COMMENT}") # log invalid packets (which are denied)
        # now it's (0) CREATE_LOG_ALLOW_CHAIN, (1) POPULATE_LOG_ALLOW_CHAIN, (2) CREATE_LOG_BLOCK_CHAIN, (3) POPULATE_LOG_DENY_CHAIN, (4) LOG_INVALID, (5) DROP_INVALID, (6) RETURN_ESTABLISH/RELATED
        if default_in == "allow":
            bottom_rules.append(f"-A {CHAIN} -i {DEFAULT_IFACE} -m conntrack --ctdir ORIGINAL{' -m limit --limit 3/min --limit-burst 10' if logging_level=='medium' else ''} -j {LOG_CHAIN_ALLOW} {RULE_COMMENT}")
        if default_out == "allow":
            bottom_rules.append(f"-A {CHAIN} -s {'172.17.0.0/12' if not ipv6_subnet else ipv6_subnet} -m conntrack --ctdir ORIGINAL{' -m limit --limit 3/min --limit-burst 10' if logging_level=='medium' else ''} -j {LOG_CHAIN_ALLOW} {RULE_COMMENT}")
            bottom_rules.append(f"-A {CHAIN} -o docker0 -m conntrack --ctdir ORIGINAL{' -m limit --limit 3/min --limit-burst 10' if logging_level=='medium' else ''} -j {LOG_CHAIN_ALLOW} {RULE_COMMENT}")
    if logging_level in ("high", "full"):
        pass # TODO NOW: log packets that have triggered rate limiting
    if logging_level == "full":
        top_rules.insert(4, f"-A {CHAIN} -m conntrack --ctstate ESTABLISHED,RELATED -j {LOG_CHAIN_ALLOW} {RULE_COMMENT}")
    if default_in in ("deny","reject"):
        bottom_rules.append(f"-A {CHAIN} -i {DEFAULT_IFACE} -m conntrack --ctdir ORIGINAL -j {'DROP' if default_in=='deny' else 'REJECT'} {RULE_COMMENT}") # deny anything in that is incoming on the default interface
    else: # default_in == "allow"
        bottom_rules.append(f"-A {CHAIN} -i {DEFAULT_IFACE} -m conntrack --ctdir ORIGINAL -j RETURN {RULE_COMMENT}") # allow anything in that is incoming on the default interface
    if default_out == "allow":
        bottom_rules.append(f"-A {CHAIN} -s {'172.17.0.0/12' if not ipv6_subnet else ipv6_subnet} -m conntrack --ctdir ORIGINAL -j RETURN {RULE_COMMENT}") # allow out anything originating from the default docker address range
        bottom_rules.append(f"-A {CHAIN} -o docker0 -m conntrack --ctdir ORIGINAL -j RETURN {RULE_COMMENT}") # allow out anything originating from the default docker address range
    else: # default_out == "deny"
        bottom_rules.append(f"-A {CHAIN} -s {'172.17.0.0/12' if not ipv6_subnet else ipv6_subnet} -m conntrack --ctdir ORIGINAL -j {'DROP' if default_out=='deny' else 'REJECT'} {RULE_COMMENT}") # deny anything originating from the default docker address range
        bottom_rules.append(f"-A {CHAIN} -o docker0 -m conntrack --ctdir ORIGINAL -j {'DROP' if default_out=='deny' else 'REJECT'} {RULE_COMMENT}") # deny anything originating from the default docker address range
    # security: drop anything that makes it past the above handling, just to be safe...
    if logging_level in ("low","medium","high","full"):
        bottom_rules.append(f"-A {CHAIN}{' -m limit --limit 3/min --limit-burst 10' if logging_level in ('low','medium') else ''} -j {LOG_CHAIN_DENY}")
    bottom_rules.append(f"-A {CHAIN} -j DROP {RULE_COMMENT}")
    return top_rules,bottom_rules

def make_fresh_rules_file(conf: Config) -> int: # need to have already check euid before calling
    content = generate_rules_text([], conf)
    with open(DFW_RULES_PATH, "w") as rules_file:
        rules_file.writelines(content)
    log("Wrote new dfw.rules.", level=INFO)

def read_rules_file() -> (list[str], int):
    rules_list = []
    try:
        with open(DFW_RULES_PATH, "r") as rules_file:
            for line in rules_file.readlines():
                if line.startswith("[RULEFORM]") and line not in rules_list: # exclude duplicate rules from IPv6 section
                    rules_list.append(line)
        log("Read rules file successfully", level=DEBUG)
        return rules_list, 0
    except FileNotFoundError:
        log(f"Reading {DFW_RULES_PATH} failed due to missing file. Aborting!", level=CRITICAL)
        return [], FILE_MISSING

def write_rules_file(content: str, action: str) -> int: # need to have already checked euid before calling
    try:
        shutil.copy2(DFW_RULES_PATH, DFW_RULES_PATH+".bak")
        log("Made backup of dfw.rules.", level=INFO)
    except FileNotFoundError:
        log(f"Couldn't back up {DFW_RULES_PATH} due to missing file. Aborting!", level=CRITICAL)
        return FILE_MISSING
    with open(DFW_RULES_PATH, "w") as rules_file:
        rules_file.writelines(content)
    log("Wrote to dfw.rules.", level=INFO)
    if action:
        print(action)
    return 0

def request_confirmation(prompt: str) -> bool:
    while True:
        check = input(f"{prompt}\nProceed with operation (y|n)? ")
        if check.lower() == "y":
            return True
        elif check.lower() == "n":
            return False

def generate_rules_text(rules: list[Rule], conf: Config) -> str:
    top_rules, bottom_rules = make_default_rules(conf.default_in, conf.default_out, conf.logging_level)
    content = (
            f"# generated by {PROGRAM_NAME} version {VERSION}. Default incoming={conf.default_in}. Default outgoing={conf.default_out}. Logging level={conf.logging_level}. ipv6_subnet={conf.ipv6_subnet}.\n\n"
            + "# Standard rules\n"
            + '\n'.join(rule.replace(":_", ": ") for rule in top_rules)
            + ("\n\n# User rules\n" if len(rules) else '')
            + ('\n\n'.join(f"{rule.print_rule_form()}\n{rule.print_rule_ipt(True, conf.logging_level)}" for rule in rules if rule.ipv_type in ("4", "both")) if len(rules) else '')
            + "\n\n# Default Policy rules\n"
            + '\n'.join(bottom_rules)
            + "\n\n"
            )
    if conf.ipv6_subnet != "Disabled":
        top_rules6, bottom_rules6 = make_default_rules(conf.default_in, conf.default_out, conf.logging_level, conf.ipv6_subnet)
        content += (
            "# IPv6 standard rules\n"
            + '\n'.join(rule.replace(":_", ": ") for rule in top_rules6)
            + ("\n\n# IPv6 User rules\n" if len(rules) else '')
            + ('\n\n'.join(f"{rule.print_rule_form()}\n{rule.print_rule_ipt(True, conf.logging_level, False)}" for rule in rules if rule.ipv_type in ("6", "both")) if len(rules) else '')
            + "\n\n# IPv6 Default Policy rules\n"
            + '\n'.join(bottom_rules6)
            + "\n\n"
                )
    return content

def process_rule(new_rule: Rule, conf: Config) -> (str,str,int):
    rules_str_list,err_code = read_rules_file()
    if err_code != 0:
        return "","",err_code
    rules = []
    for rule_str in rules_str_list:
        try:
            rule = Rule.parse_rule_form(rule_str)
        except ValueError as e:
            log(f"ERROR: {e} in {DFW_RULES_PATH}", level=ERROR)
            return "","",RULE_INVALID
        rules.append(rule)
    if new_rule.modification == "delete":
        if new_rule.delete_index:
            index = int(new_rule.delete_index)
            if len(rules) < 1 or len(rules) < index:
                log(f"ERROR: Could not find rule \"{index}\"", level=ERROR)
                return "","",NONEXISTANT_RULE
            if request_confirmation(f"Deleting:\n {rules[index-1].print_rule_dfw()}") == True:
                del rules[index-1]
            else:
                return "","",CONFIRMATION_DENIED
        else:
            index = -1
            for i,rule in enumerate(rules):
                if new_rule == rule and new_rule.comment == rule.comment:
                    index = i
                    break
            else:
                log("Could not delete non-existent rule", level=WARNING)
                return "","",NONEXISTANT_RULE
            del rules[index]
        summary = "Rule deleted"
        if conf.ipv6_subnet != "Disabled":
            summary += "\nRule deleted (v6)"
    else: # modification is "", "prepend", or "insert"
        summary = ""
        for i,rule in enumerate(rules):
            if new_rule == rule:
                index = i
                if new_rule.comment != rule.comment:
                    summary = "Rule updated"
                    break
                summary = "duplicate"
                break
        else:
            if new_rule.ipv_type in ("4", "both"):
                summary = "Rule added"
            if conf.ipv6_subnet != "Disabled":
                summary += "\nRule added (v6)"
        if summary == "Rule updated" and not new_rule.modification: # valid rule comment update detected
            rules[index] = new_rule
        elif new_rule.modification in ("insert","prepend"):
            if summary in ("Rule updated", "duplicate"): # cannot update an existing rule via insert/prepend
                if new_rule.ipv_type in ("4", "both"):
                    log("Skipping inserting existing rule", level=WARNING)
                if conf.ipv6_subnet != "Disabled" and new_rule.ipv_type in ("both", "6"):
                    log("Skipping inserting existing rule (v6)", level=WARNING)
                return "","",RULE_ALREADY_EXISTS
            index = 1 if new_rule.modification == "prepend" else int(new_rule.insert_index)
            rules.insert(index-1, new_rule)
        elif summary == "duplicate":
            if new_rule.ipv_type in ("4", "both"):
                log("Skipping adding existing rule", level=WARNING)
            if conf.ipv6_subnet != "Disabled":
                log("Skipping adding existing rule (v6)", level=WARNING)
            return "","",RULE_ALREADY_EXISTS
        else:
            rules.append(new_rule)
    content = generate_rules_text(rules, conf)
    return content,summary,0

def rules_file_is_valid(conf: Config) -> (bool, int):
    try:
        with open(DFW_RULES_PATH, "r") as rules_file:
            line = rules_file.readline().strip()
        log("Read rules file first line successfully", level=DEBUG)
        return line == f"# generated by {PROGRAM_NAME} version {VERSION}. Default incoming={conf.default_in}. Default outgoing={conf.default_out}. Logging level={conf.logging_level}. ipv6_subnet={conf.ipv6_subnet}.",0
    except FileNotFoundError:
        log(f"Reading {DFW_RULES_PATH} failed due to missing file. Aborting!", level=CRITICAL)
        return False, FILE_MISSING

def regenerate_rules_file(conf: Config) -> int:
    rules_str_list,err_code = read_rules_file()
    if err_code != 0:
        return err_code
    rules = []
    for rule_str in rules_str_list:
        try:
            rule = Rule.parse_rule_form(rule_str)
        except ValueError as e:
            log(f"ERROR: {e} in {DFW_RULES_PATH}", level=ERROR)
            return RULE_INVALID
        rules.append(rule)
    content = generate_rules_text(rules, conf)
    write_rules_file(content,"")
    return 0

def chain_exists(chain: str, version="4") -> bool:
    try:
        if version not in ("4","6"):
            raise ValueError(f"Invalid value for version: {version}")
        log(f"Checking for existance of ipv{version} chain: {chain}", level=DEBUG)
        iptables = "iptables" if version == "4" else "ip6tables"
        result = subprocess.run([iptables, "-L", f"{chain}", "-n"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return result.returncode == 0
    except FileNotFoundError:
        return False

def read_chain(chain: str, version="4") -> (str, int):
    try:
        if version not in ("4","6"):
            raise ValueError(f"Invalid value for version: {version}")
        log(f"Reading ipv{version} chain: {chain}", level=DEBUG)
        iptables = "iptables" if version == "4" else "ip6tables"
        result = subprocess.run([iptables, "-L", chain, "-v", "-n"], capture_output=True, text=True, check=True)
        return result.stdout,result.returncode
    except subprocess.CalledProcessError as e:
        log(f"List command failed for chain: {chain}.\n Error: {e.stderr}", level=CRITICAL)
        return "",IPTABLES_ERROR

def flush_chain(chain: str, version="4") -> int:
    try:
        if version not in ("4","6"):
            raise ValueError(f"Invalid value for version: {version}")
        log(f"Flushing ipv{version} chain: {chain}", level=DEBUG)
        iptables = "iptables" if version == "4" else "ip6tables"
        result = subprocess.run([iptables, "-F", chain], capture_output=True, text=True, check=True)
        return result.returncode
    except subprocess.CalledProcessError as e:
        log(f"Flush command failed for chain: {chain}.\n Error: {e.stderr}", level=CRITICAL)
        return IPTABLES_ERROR

def delete_chain(chain: str, version="4") -> int:
    try:
        if version not in ("4","6"):
            raise ValueError(f"Invalid value for version: {version}")
        log(f"Deleting ipv{version} chain: {chain}", level=DEBUG)
        iptables = "iptables" if version == "4" else "ip6tables"
        result = subprocess.run([iptables, "-X", chain], capture_output=True, text=True, check=True)
        return result.returncode
    except subprocess.CalledProcessError as e:
        log(f"Delete command failed for chain: {chain}.\n Error: {e.stderr}", level=CRITICAL)
        return IPTABLES_ERROR

def push_rules_to_iptables(conf: Config) -> int:
    rules_str_list,err_code = read_rules_file()
    if err_code != 0:
        return err_code
    rules = []
    for rule_str in rules_str_list:
        try:
            rule = Rule.parse_rule_form(rule_str)
        except ValueError as e:
            log(f"ERROR: {e} in {DFW_RULES_PATH}", level=ERROR)
            return "","",RULE_INVALID
        rules.append(rule)
    cmds = []
    top_rules, bottom_rules = make_default_rules(conf.default_in, conf.default_out, conf.logging_level)
    cmds.extend(f"iptables {rule}" for rule in top_rules)
    cmds.extend(f"iptables {line}" for rule in rules for line in rule.print_rule_ipt(True, conf.logging_level).split("\n") if line and rule.ipv_type in ("4","both"))
    cmds.extend(f"iptables {rule}" for rule in bottom_rules)
    log(f"{cmds=}", level=TRACE)
    if (err_code := flush_chain(CHAIN)):
        return err_code
    for chain in (LOG_CHAIN_ALLOW, LOG_CHAIN_DENY):
        if chain_exists(chain):
            if (err_code := flush_chain(chain)):
                return err_code
            if (err_code := delete_chain(chain)):
                return err_code
    for cmd in cmds:
        try:
            cmd_list = [i.replace(":_", ": ") for i in cmd.split()]
            log(f"calling run with {cmd_list=}", level=TRACE)
            result = subprocess.run(cmd_list, capture_output=True, text=True, check=True)
        except subprocess.CalledProcessError as e:
            log(f"Command failed: {cmd}\n Error: {e.stderr}", level=CRITICAL)
            return IPTABLES_ERROR
    log("Pushed rules to iptables", level=DEBUG)
    if chain_exists(CHAIN, "6") and conf.ipv6_subnet != "Disabled":
        cmds6 = []
        top_rules6, bottom_rules6 = make_default_rules(conf.default_in, conf.default_out, conf.logging_level, conf.ipv6_subnet)
        cmds6.extend(f"ip6tables {rule}" for rule in top_rules6)
        cmds6.extend(f"ip6tables {line}" for rule in rules for line in rule.print_rule_ipt(True, conf.logging_level).split("\n", False) if line and rule.ipv_type in ("6", "both"))
        cmds6.extend(f"ip6tables {rule}" for rule in bottom_rules6)
        log(f"{cmds6=}", level=TRACE)
        if (err_code := flush_chain(CHAIN, "6")):
            return err_code
        for chain in (LOG_CHAIN_ALLOW, LOG_CHAIN_DENY):
            if chain_exists(chain, "6"):
                if (err_code := flush_chain(chain, "6")):
                    return err_code
                if (err_code := delete_chain(chain, "6")):
                    return err_code
        for cmd6 in cmds6:
            try:
                cmd6_list = [i.replace(":_", ": ") for i in cmd6.split()]
                log(f"calling run with {cmd6_list=}", level=TRACE)
                result = subprocess.run(cmd6_list, capture_output=True, text=True, check=True)
            except subprocess.CalledProcessError as e:
                log(f"Command failed: {cmd6}\n Error: {e.stderr}", level=CRITICAL)
                return IPTABLES_ERROR
        log("Pushed rules to ip6tables", level=DEBUG)
    return 0

def generate_statuses(numbered: bool, verbose: bool, ipv6_enabled:bool, logging_level="", default_in="", default_out="") -> (str,int):
    rules_str_list,err_code = read_rules_file()
    if err_code != 0:
        return "",err_code
    rules = []
    for rule_str in rules_str_list:
        try:
            rule = Rule.parse_rule_form(rule_str)
        except ValueError as e:
            log(f"ERROR: {e} in {DFW_RULES_PATH}", level=ERROR)
            return "",RULE_INVALID
        rules.append(rule)
    if numbered == True:
        statuses = [[str(index+1), *rule.to_status(True)] for index,rule in enumerate(rules) if rule.ipv_type in ("4", "both")]
        if ipv6_enabled:
            statuses.extend([[str(index+1), *rule.to_status(True, True)] for index,rule in enumerate(rules) if rule.ipv_type in ("6", "both")])
    else:
        statuses = [rule.to_status(verbose) for rule in rules if rule.ipv_type in ("4", "both")]
        if ipv6_enabled:
            statuses.extend([rule.to_status(verbose, True) for rule in rules if rule.ipv_type in ("6", "both")])
    sep = 7
    headers = ["To", "Action", "From", "\n"]
    if numbered:
        num_digits = len(str(len(statuses)))
        headers[0] = " "*(num_digits+3)+headers[0]
        for status in statuses:
            status[1] = f"[{' '*(num_digits-len(status[0]))}{status[0]}] {status[1]}"
            del status[0]
    max_lens = []
    if len(statuses):
        for i in range(4):
            max_lens.append(max(len(status_parts[i]) for status_parts in statuses))
    else:
        max_lens = [0, 0, 0, 0]
    header_padding = (' '*(max_lens[0]-len(headers[0])+sep), ' '*(max_lens[1]-len(headers[1])+sep))
    headers.insert(1, header_padding[0])
    headers.insert(3, header_padding[1])
    padded_statuses = []
    for status_parts in statuses:
        padded_parts = []
        for i in range(4):
            padded_parts.append(status_parts[i]+" "*(max_lens[i]-len(status_parts[i])))
        padded_statuses.append(tuple(padded_parts))
    joined_headers = ''.join(headers)
    if verbose:
        content = f"Status: active\nLogging: {logging_level}\nDefault: {default_in} (incoming), {default_out} (outgoing)\nNew profiles: skip\n\n" + joined_headers
        # TODO when adding support for applications, change the logic for New profiles in the line above, although skip is the recommended behavior, so I may just make it the only option...
    else:
        content = "Status: active\n\n" + joined_headers
    if numbered and ipv6_enabled:
        content = "Note: a user rule that applies to both ipv4 and ipv6 is stored as one rule internally.\n      Therefore, the numbered list has duplicate numbers for ipv4+ipv6 rules as two lines correspond to the same rule.\n"+ content
    dash_line = ''.join([" " if char in (" ", "\n") else "-" for char in joined_headers]) + "\n"
    content += dash_line
    for status_parts in padded_statuses:
        content += f"{status_parts[0]}{' '*sep}{status_parts[1]}{' '*sep}{status_parts[2]}{' '*sep}{status_parts[3]}\n"
    return content,0

def enable_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    log(f"{args=}", level=TRACE)
    if args.config.enabled:
        log(f"{PROGRAM_NAME} is already enabled.", level=WARNING)
        return 0
    args.config.enabled = True
    if not args.dry_run:
        if (err_code := confirm_root_and_chain()):
            return err_code
        write_config(args.config)
        is_valid,err_code = rules_file_is_valid(args.config)
        if err_code != 0:
            return err_code
        if not is_valid and (err_code := regenerate_rules_file(args.config)):
            return err_code
        if (err_code := push_rules_to_iptables(args.config)):
            return err_code
        print("Firewall is active and enabled on system startup (if the corresponding init service is also enabled)")
    return 0

def disable_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    log(f"{args=}", level=TRACE)
    args.config.enabled = False
    if not args.dry_run:
        if (err_code := confirm_root_and_chain()):
            return err_code
        write_config(args.config)
        is_valid,err_code = rules_file_is_valid(args.config)
        if err_code != 0:
            return err_code
        if not is_valid and (err_code := regenerate_rules_file(args.config)):
            return err_code
        if (err_code := flush_chain(CHAIN)):
            return err_code
        if chain_exists(CHAIN, "6"):
            if (err_code := flush_chain(CHAIN, "6")):
                return err_code
        for chain in (LOG_CHAIN_ALLOW, LOG_CHAIN_DENY):
            if chain_exists(chain):
                if (err_code := flush_chain(chain)):
                    return err_code
                if (err_code := delete_chain(chain)):
                    return err_code
            if chain_exists(chain, "6"):
                if (err_code := flush_chain(chain, "6")):
                    return err_code
                if (err_code := delete_chain(chain, "6")):
                    return err_code
        print("Firewall stopped and disabled on system startup")
    return 0

def default_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    log(f"{args=}", level=TRACE)
    if len(remainder) != 2 or remainder[0] not in ("allow", "deny", "reject") or remainder[1] not in ("incoming", "outgoing"):
        log("ERROR: Invalid Syntax", level=ERROR)
        print(args.help_text)
        return INVALID_COMMAND
    if remainder[1] == "incoming":
        args.config.default_in = remainder[0]
    else:
        args.config.default_out = remainder[0]
    if not args.dry_run:
        if (err_code := confirm_root_and_chain()):
            return err_code
        write_config(args.config)
        if (err_code := regenerate_rules_file(args.config)):
            return err_code
        if args.config.enabled:
            return push_rules_to_iptables(args.config)
        else:
            print(f"Note: {PROGRAM_NAME} is disabled. Operation not applied to live firewall.")
    return 0

def logging_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    # logging on|off|LEVEL
    #        toggle  logging.  Logged  packets use the LOG_KERN syslog facility. Systems configured for rsyslog support may also
    #        log to /var/log/ufw.log. Specifying a LEVEL turns logging on for the specified LEVEL.  The  default  log  level  is
    #        'low'.  See LOGGING for details.
    log(f"{args=}", level=TRACE)
    if len(remainder) != 1 or remainder[0] not in ("off", "on", "low", "medium", "high", "full"):
        log("ERROR: Invalid Syntax", level=WARNING)
        print(args.help_text)
        return INVALID_COMMAND
    if args.config.logging_level == remainder[0] or remainder[0] == "on" and args.config.logging_level != "off":
        print(f"Logging is already set to {remainder[0]}. No changes made.")
        return 0
    try:
        args.config.logging_level = remainder[0]
    except ValueError as e:
        log(f"ERROR: Invalid Syntax: {e}", level=WARNING)
        print(args.help_text)
        return INVALID_COMMAND
    if not args.dry_run:
        if (err_code := confirm_root_and_chain()):
            return err_code
        write_config(args.config)
        if (err_code := regenerate_rules_file(args.config)):
            return err_code
        if args.config.logging_level != "off":
            print("Logging enabled")
        else:
            print("Logging disabled")
        if args.config.enabled:
            return push_rules_to_iptables(args.config)
        else:
            print(f"Note: {PROGRAM_NAME} is disabled. Operation not applied to live firewall.")
    return 0

def rule_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    # Example of limit
    # -A DOCKER-USER -p tcp -m conntrack --ctorigdstport 8080 --ctstate NEW -m recent --set --name PORT8080
    # -A DOCKER-USER -p tcp -m conntrack --ctorigdstport 8080 --ctstate NEW -m recent --update --seconds 30 --hitcount 6 --name PORT8080 -j DROP
    log(f"{args=}", level=TRACE)
    log(f"command and remainder are: {args.command}, {' '.join(remainder)}", level=TRACE)
    try:
        rule = Rule.parse_rule_command(f"{args.command} {' '.join(remainder)}")
    except ValueError as e:
        log(f"ERROR: {e}", level=ERROR)
        if e == "Invalid Syntax":
            print(args.help_text)
        return RULE_INVALID
    log(f"{rule.__dict__}", level=TRACE)
    new_rules,summary,err_code = process_rule(rule, args.config)
    if err_code != 0:
        return err_code
    # perform some checks and provide clarity to the user
    if rule.modification in ("", "insert", "prepend"): # if we're adding a new rule
        if rule.ipv_type == "6" and args.config.ipv6_subnet == "Disabled":
            log(f"IPv6 functionality is disabled in {DFW_CONFIG_PATH}. No changes made", level=ERROR)
            return IPV6_DISABLED
        # if rule != Rule.parse_rule_form(rule.print_rule_form()):
        #     log(f"{rule.__dict__=}\nvs\n{Rule.parse_rule_form(rule.print_rule_form()).__dict__=}", level=DEBUG)
        #     log("ERROR: Internal consistency check failed!", level=ERROR)
        #     return INTERNAL_ERROR
        if rule.action and not args.dry_run:
            log(rule.print_rule_ipt(logging_level=args.config.logging_level, ipv4=(rule.ipv_type in ("4","both"))), level=TRACE)
    if not args.dry_run:
        if err_code := (confirm_root_and_chain() or write_rules_file(new_rules,summary)):
            return err_code
        if args.config.enabled:
            return push_rules_to_iptables(args.config)
        else:
            print(f"Note: {PROGRAM_NAME} is disabled. Operation not applied to live firewall.")
    else:
        print(new_rules, summary, sep="\n")
        return 0

def reload_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    log(f"{args=}", level=TRACE)
    if not args.dry_run:
        if (err_code := confirm_root_and_chain()):
            return err_code
        is_valid,err_code = rules_file_is_valid(args.config)
        if err_code != 0:
            return err_code
        if not is_valid and (err_code := regenerate_rules_file(args.config)):
            return err_code
        print("Firewall reloaded")
        if args.config.enabled:
            push_rules_to_iptables(args.config)
        else:
            print(f"Note: {PROGRAM_NAME} is disabled. Operation not applied to live firewall.")
    return 0

def reset_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    log(f"{args=}", level=TRACE)
    if not args.dry_run:
        if (err_code := confirm_root_and_chain()):
            return err_code
        write_config(Config.default_config)
        if (err_code := flush_chain(CHAIN)):
            return err_code
        if chain_exists(CHAIN, "6"):
            if (err_code := flush_chain(CHAIN, "6")):
                return err_code
        for chain in (LOG_CHAIN_ALLOW, LOG_CHAIN_DENY):
            if chain_exists(chain):
                if (err_code := flush_chain(chain)):
                    return err_code
                if (err_code := delete_chain(chain)):
                    return err_code
            if chain_exists(chain, "6"):
                if (err_code := flush_chain(chain, "6")):
                    return err_code
                if (err_code := delete_chain(chain, "6")):
                    return err_code
        write_rules_file("", "All configurations and rules reset to default")
    else:
        print("--dry-run enabled. No operations performed")
    return 0

