def show_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    log(f"{args=}", level=TRACE)
    # TODO LATER Add support for other reports supported by ufw (low priority)
    if (err_code := confirm_root_and_chain()):
        return err_code
    if len(remainder) != 1 or remainder[0] not in ("raw", "added"):
        log("Invalid syntax", level=CRITICAL)
        print(args.help_text)
        return INVALID_COMMAND
    report = remainder[0]
    if report == "raw":
        content = "IPv4:\n"
        content_extra,err_code = read_chain(CHAIN)
        if err_code:
            return err_code
        content += content_extra
        for chain in (LOG_CHAIN_DENY, LOG_CHAIN_ALLOW):
            if chain_exists(chain):
                content_extra,err_code = read_chain(chain)
                if err_code:
                    return err_code
                content += content_extra
        if chain_exists(CHAIN, "6") and args.config.ipv6_subnet != "Disabled":
            content_extra,err_code = read_chain(CHAIN, "6")
            if err_code:
                return err_code
            content += "IPv6:\n"
            content += content_extra
            for chain in (LOG_CHAIN_DENY, LOG_CHAIN_ALLOW):
                if chain_exists(chain, "6"):
                    content_extra,err_code = read_chain(chain, "6")
                    if err_code:
                        return err_code
                    content += content_extra
    if report == "added":
        rules_str_list,err_code = read_rules_file()
        if err_code != 0:
            return err_code
        rules = []
        for rule_str in rules_str_list:
            try:
                rule = Rule.parse_rule_form(rule_str)
            except ValueError as e:
                log(f"ERROR: {e} in {DFW_RULES_PATH}", level=ERROR)
                return RULE_INVALID
            rules.append(rule)
        content = f"Added user rules (see \"{PROGRAM_NAME} status\" for running firewall):\n"
        content += '\n'.join(f"{PROGRAM_NAME} {rule.print_rule_dfw()}" for rule in rules)
    print(content)
    return 0

def version_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    log(f"{args=}", level=TRACE)
    print(get_version_string())
    return 0

def configure_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM_NAME, description="CLI tool accepting ufw-like commands to create firewall rules that docker will respect.")
    parser.add_argument("-d", "--dry-run", action="store_true", help="Run using given input without making any change to the system. This tests the provided command for validity.")
    parser.add_argument("-v", "--verbose", action="count", default=0, help="Enable verbose logging (repeat up to 3x for increased verbosity).")
    parser.add_argument("-s", "--suppress", action="count", default=0, help="Suppress error messages (repeat up to 2x to suppress all log messages")
    parser.add_argument("-V", "--version", action="version", version=get_version_string())

    subparsers = parser.add_subparsers(dest="command", required=True, help="Provide the command to run")

    enable_parser = subparsers.add_parser("enable", help=f"Enables {PROGRAM_NAME} immediately and at startup")
    enable_parser.set_defaults(func=enable_func)

    disable_parser = subparsers.add_parser("disable", help=f"Disables {PROGRAM_NAME} immediately and at startup")
    disable_parser.set_defaults(func=disable_func)

    default_parser = subparsers.add_parser("default", help=f"Set the default policy (allow, deny, or reject) for incoming or outgoing traffic")
    default_parser.set_defaults(func=default_func)

    logging_parser = subparsers.add_parser("logging", help=f"Set the logging level for {PROGRAM_NAME} rules")
    logging_parser.set_defaults(func=logging_func)

    rule_parser = subparsers.add_parser("rule", help=f"Add a rule")
    rule_parser.set_defaults(func=rule_func)

    allow_parser = subparsers.add_parser("allow", help=f"Add an allow rule")
    allow_parser.set_defaults(func=rule_func)

    deny_parser = subparsers.add_parser("deny", help="Add a deny rule")
    deny_parser.set_defaults(func=rule_func)

    reject_parser = subparsers.add_parser("reject", help="Add a reject rule")
    reject_parser.set_defaults(func=rule_func)

    limit_parser = subparsers.add_parser("limit", help="Add a limit rule")
    limit_parser.set_defaults(func=rule_func)

    delete_parser = subparsers.add_parser("delete", help="Delete the specified rule")
    delete_parser.set_defaults(func=rule_func)

    insert_parser = subparsers.add_parser("insert", help="Insert a rule as the given index")
    insert_parser.set_defaults(func=rule_func)

    prepend_parser = subparsers.add_parser("prepend", help="Insert a rule at position 1")
    prepend_parser.set_defaults(func=rule_func)

    reload_parser = subparsers.add_parser("reload", help=f"Removes and re-adds all {PROGRAM_NAME}-added rules from/to iptables/ip6tables")
    reload_parser.set_defaults(func=reload_func)

    reset_parser = subparsers.add_parser("reset", help=f"Disables {PROGRAM_NAME}, resets all configuration values for {PROGRAM_NAME} to the default, and deletes all user-added rules")
    reset_parser.set_defaults(func=reset_func)

    status_parser = subparsers.add_parser("status", help=f"shows firewall status. Use {PROGRAM_NAME} status --help for more options")
    status_parser.set_defaults(func=status_func)
    status_parser_subparsers = status_parser.add_subparsers(dest="", required=False)
    status_numbered_parser = status_parser_subparsers.add_parser("numbered", help=f"shows firewall status as a numbered list")
    status_numbered_parser.set_defaults(func=status_numbered_func)
    status_verbose_parser = status_parser_subparsers.add_parser("verbose", help=f"shows firewall status with additional details")
    status_verbose_parser.set_defaults(func=status_verbose_func)

    show_parser = subparsers.add_parser("show", help=f"Print a report of the current {PROGRAM_NAME}-managed rules in the firewall (raw) or the commands used to add user rules (added)")
    show_parser.set_defaults(func=show_func)

    version_parser = subparsers.add_parser("version", help=f"Print {PROGRAM_NAME} version info")
    version_parser.set_defaults(func=version_func)

    return parser

def confirm_root_and_chain() -> int:
    if os.geteuid() != 0:
        log("You need to be root to run this script", level=CRITICAL)
        return NOT_ROOT
    if not chain_exists(CHAIN):
        log(f"ERROR: docker isn't enabled, the {CHAIN} chain does not exist in iptables, the iptables command doesn't exist, or you don't have permission to use iptables. Ensure docker and iptables are enabled and correctly configured on your system.", level=CRITICAL)
        return IPTABLES_ERROR
    return 0

def shutdown() -> int:
    if (err_code := confirm_root_and_chain()):
        return err_code
    if (err_code := flush_chain(CHAIN)):
        return err_code
    if chain_exists(CHAIN, "6"):
        if (err_code := flush_chain(CHAIN, "6")):
            return err_code
    for chain in (LOG_CHAIN_ALLOW, LOG_CHAIN_DENY):
        if chain_exists(chain):
            if (err_code := flush_chain(chain)):
                return err_code
            if (err_code := delete_chain(chain)):
                return err_code
        if chain_exists(chain, "6"):
            if (err_code := flush_chain(chain, "6")):
                return err_code
            if (err_code := delete_chain(chain, "6")):
                return err_code
    return 0

def main():
    global LOG_LEVEL
    LOG_LEVEL = INFO
    if "DFW_STOP" in os.environ:
        print(f"{PROGRAM_NAME.upper()}: Stopping")
        sys.exit(shutdown())
    is_root = os.geteuid() == 0
    if not os.path.exists(DFW_CONFIG_PATH):
        if is_root:
            log(f"config file does not exist at {DFW_CONFIG_PATH}. Making a new, blank config file.", level=INFO)
            write_config(Config.default_config)
        else:
            log("You need to be root to run this script", level=CRITICAL)
            sys.exit(NOT_ROOT)
    try:
        config = Config.parse_config_str(read_config())
    except ValueError as e:
        log(f"ERROR: {e}", level=CRITICAL)
        sys.exit(CONFIG_INVALID)
    if not os.path.exists(DFW_RULES_PATH):
        if is_root:
            log(f"{DFW_RULES_PATH} doesn't exist. Creating default rules file.", level=INFO)
            make_fresh_rules_file(config)
        else:
            log("You need to be root to run this script", level=CRITICAL)
            sys.exit(NOT_ROOT)
    if "DFW_START" in os.environ:
        print(f"{PROGRAM_NAME.upper()}: Starting")
        args = argparse.Namespace(dry_run=False, config=config)
        sys.exit(reload_func(args, tuple()))
    parser = configure_parser()
    args,remainder = parser.parse_known_args()
    args.config = config
    if args.verbose >= 3:
        LOG_LEVEL = TRACE
    elif args.verbose == 2:
        LOG_LEVEL = DEBUG
    elif args.verbose == 1:
        LOG_LEVEL = INFO
    elif args.suppress == 1:
        LOG_LEVEL = ERROR
    elif args.suppress >= 2:
        LOG_LEVEL = CRITICAL
    else:
        LOG_LEVEL = WARNING
    log(*sys.argv, level=DEBUG)
    DEFAULT_IFACE = get_default_interface()
    args.help_text = parser.format_help()
    sys.exit(args.func(args, remainder))

if __name__ == "__main__":
    main()
