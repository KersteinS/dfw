    except FileNotFoundError:
        log(f"Couldn't back up {DFW_RULES_PATH} due to missing file. Aborting!", level=CRITICAL)
        return FILE_MISSING
    with open(DFW_RULES_PATH, "w") as rules_file:
        rules_file.writelines(content)
    log("Wrote to dfw.rules.", level=DEBUG)
    print(action)
    return 0

def request_confirmation(prompt: str) -> bool:
    while True:
        check = input(f"{prompt}\nProceed with operation (y|n)? ")
        if check.lower() == "y":
            return True
        elif check.lower() == "n":
            return False

def process_rule(new_rule: Rule, default_in="deny", default_out="allow") -> (str,str,int):
    # Rule context:
    # -A DOCKER-USER -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN # Allow containers to reach out
    # -A DOCKER-USER -i docker0 -j RETURN # allow docker-internal comms part 1 (by interface)
    # -A DOCKER-USER -s 172.17.0.0/12 -j RETURN # allow docker-internal comms part 2 (by subnet)
    # append all other rules here
    # -A DOCKER-USER -j DROP # drop all other conns # This is the default action line. So it can be RETURN or DROP (allow or deny)
    rules_str_list,check = read_rules_file()
    if check != 0:
        return "","",check
    rules = []
    for rule_str in rules_str_list:
        try:
            rule = Rule.parse_rule_form(rule_str)
        except ValueError as e:
            log(f"ERROR: {e} in {DFW_RULES_PATH}", level=ERROR)
            return "","",RULE_INVALID
        rules.append(rule)
    if new_rule.modification == "delete":
        if new_rule.delete_index:
            index = int(new_rule.delete_index)
            if len(rules) < 1 or len(rules) < index:
                log(f"ERROR: Could not find rule \"{index}\"", level=ERROR)
                return "","",NONEXISTANT_RULE
            if request_confirmation(f"Deleting:\n {rules[index-1].print_rule_dfw()}") == True:
                del rules[index-1]
            else:
                return "","",CONFIRMATION_DENIED
        else:
            index = -1
            for i,rule in enumerate(rules):
                if new_rule == rule and new_rule.comment == rule.comment:
                    index = i
                    break
            else:
                log("Could not delete non-existant rule", level=WARNING)
                return "","",NONEXISTANT_RULE
            del rules[index]
        summary = "Rule deleted"
    else: # modification is "", "prepend", or "insert"
        summary = ""
        for i,rule in enumerate(rules):
            if new_rule == rule:
                index = i
                if new_rule.comment != rule.comment:
                    summary = "Rule updated"
                    break
                summary = "duplicate"
                break
        else:
            summary = "Rule added"
        if "updated" in summary and not new_rule.modification: # valid rule comment update detected
            rules[index] = new_rule
        elif new_rule.modification in ("insert","prepend"):
            if summary in ("Rule updated", "duplicate"): # cannot update an existing rule via insert/prepend
                log("Skipping inserting existing rule", level=WARNING)
                return "","",RULE_ALREADY_EXISTS
            index = 1 if new_rule.modification == "prepend" else int(new_rule.insert_index)
            rules.insert(index-1, new_rule)
        elif summary == "duplicate":
            log("Skipping adding existing rule", level=WARNING)
            return "","",RULE_ALREADY_EXISTS
        else:
            rules.append(new_rule)
    content = (
        f"# generated by {PROGRAM_NAME} version {VERSION}. Default incoming={default_in}. Default outgoing={default_out}.\n\n"
        + (f"{RULES_HEAD_ALLOW_OUT}\n" if default_out=="allow" else f"{RULES_HEAD_DENY_OUT}\n")
        + '\n\n'.join(f"{rule.print_rule_form()}\n{rule.print_rule_ipt(True)}" for rule in rules)
        + (f"\n\n{RULES_TAIL_DENY_IN}\n" if default_in=="deny" else f"\n\n{RULES_TAIL_ALLOW_IN}\n")
    )
    return content,summary,0

def status_is_enabled() -> (bool, int):
    #TODO
    # This needs testing and refining. I want proper error handling if something is wrong in the command itself (using check=True) but I expect grep to return non-zero if dfw is disabled...
    # shell=True is a security risk, technically speaking but since no part of the input relies on user-input it should be okay.
    try:
        result = subprocess.run(f"iptables -S | grep -- '{RULE_COMMENT}'", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        return result.returncode == 0
    except Exception as e:
        print(f"Exception occurred: {e}")
        return False, 1

def flush_chain(chain: str) -> int:
    try:
        log(f"flushing chain: {chain}", level=DEBUG)
        result = subprocess.run(["iptables", "-F", chain], capture_output=True, text=True, check=True)
        return result.returncode
    except subprocess.CalledProcessError as e:
        log(f"Flush command failed: {cmd}\n Error: {e.stderr}", CRITICAL)
        return IPTABLES_ERROR

# I need to make sure that if docker restarts, this application detects that and re-applies the rules. docker restart flushes the DOCKER_USER chain, you see.
def push_rules_to_iptables(default_in: str, default_out: str) -> int:
    rules_str_list,check = read_rules_file()
    if check != 0:
        return check
    rules = []
    for rule_str in rules_str_list:
        try:
            rule = Rule.parse_rule_form(rule_str)
        except ValueError as e:
            log(f"ERROR: {e} in {DFW_RULES_PATH}", level=ERROR)
            return "","",RULE_INVALID
        rules.append(rule)
    cmds = []
    if default_out == "allow":
        out_rule = RULES_HEAD_ALLOW_OUT
    else:
        out_rule = RULES_HEAD_DENY_OUT
    if default_in == "deny":
        in_rule = RULES_TAIL_DENY_IN
    else:
        in_rule = RULES_TAIL_ALLOW_IN
    cmds.extend(f"iptables {rule}" for rule in out_rule.split("\n") if rule)
    cmds.extend(f"iptables {line}" for rule in rules for line in rule.print_rule_ipt(True).split("\n") if line)
    cmds.extend(f"iptables {rule}" for rule in in_rule.split("\n") if rule)
    log(f"{cmds=}", level=DEBUG)
    if (check := flush_chain(CHAIN)):
        return check
    for cmd in cmds:
        try:
            cmd_list = cmd.split()
            log(f"calling run with {cmd_list=}", level=DEBUG)
            result = subprocess.run(cmd_list, capture_output=True, text=True, check=True)
        except subprocess.CalledProcessError as e:
            log(f"Command failed: {cmd}\n Error: {e.stderr}", CRITICAL)
            return IPTABLES_ERROR
    return 0

def enable_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    # TODO needs to also enable the start-up procedure (systemd unit?)
    log(f"{args=}", level=TRACE)
    args.config.enabled = True
    if not args.dry_run:
        if (check := confirm_root_and_chain()):
            return check
        write_config(args.config)
        if (check := push_rules_to_iptables(args.config.default_in, args.config.default_out)):
            return check
        print("Firewall is active [TRUE] and enabled on system startup [FALSE]")
    return 0

def disable_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    # TODO needs to also disable the start-up procedure (systemd unit?)
    log(f"{args=}", level=TRACE)
    args.config.enabled = False
    if not args.dry_run:
        if (check := confirm_root_and_chain()):
            return check
        write_config(args.config)
        if (check := flush_chain(CHAIN)):
            return check
        print("Firewall stopped [TRUE] and disabled on system startup [FALSE]")
    return 0

def default_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    # default allow|deny|reject DIRECTION
    #        change the default policy for traffic going DIRECTION, where DIRECTION is one of incoming or outgoing. Note
    #        that existing rules will have to be migrated manually when changing the default policy. See RULE SYNTAX for more on
    #        deny and reject.
    log(f"{args=}", level=TRACE)
    if len(remainder) != 2 or remainder[0] not in ("allow", "deny", "reject") or remainder[1] not in ("incoming", "outgoing"):
        log("ERROR: Invalid Syntax", level=ERROR)
        return INVALID_COMMAND
    if remainder[0] == "reject":
        log(f"{PROGRAM_NAME} does not currently support \"reject\"", level=CRITICAL)
        return FEATURE_INCOMPLETE
    if remainder[1] == "incoming":
        args.config.default_in = remainder[0]
    else:
        args.config.default_out = remainder[0]
    if not args.dry_run:
        if (check := confirm_root_and_chain()):
            return check
        write_config(args.config)
        return push_rules_to_iptables(args.config.default_in, args.config.default_out)
    return 0

