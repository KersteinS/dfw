def rule_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    # Example of blocking port 8080
    # :DOCKER-USER - [0:0]
    # -A DOCKER-USER -m conntrack --ctorigdstport 8080 -p tcp -j DROP
    # -A DOCKER-USER -m conntrack --ctorigdstport 8080 -p udp -j DROP
    # -A DOCKER-USER -j RETURN
    # Example of limit
    # :DOCKER-USER - [0:0]
    # -A DOCKER-USER -p tcp -m conntrack --ctorigdstport 8080 --ctstate NEW -m recent --set --name PORT8080
    # -A DOCKER-USER -p tcp -m conntrack --ctorigdstport 8080 --ctstate NEW -m recent --update --seconds 30 --hitcount 6 --name PORT8080 -j DROP
    # -A DOCKER-USER -j RETURN
    log(f"{args=}", level=TRACE)
    log(f"command and remainder are: {args.command}, {' '.join(remainder)}", level=TRACE)
    try:
        rule = Rule.parse_rule_command(f"{args.command} {' '.join(remainder)}")
    except ValueError as e:
        log(f"ERROR: {e}", level=ERROR)
        return 1
    log(vars(rule), level=DEBUG)
    if not rule.modification: # don't test on delete/insert/prepend rules
        check_rule_form_parsing(rule)
    if rule.action:
        log(f"{rule.print_rule_ipt(True)=}", level=DEBUG)
    # need to place the rule in the rule file then update the rules in iptables
    new_rules,summary,check = process_rule(rule, "deny") # TODO implement config checking to see if we are doing deny or allow as default
    if check != 0:
        return check
