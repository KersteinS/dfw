def rule_func(args: argparse.Namespace, remainder: tuple[str]) -> int:
    # Example of limit
    # :DOCKER-USER - [0:0]
    # -A DOCKER-USER -p tcp -m conntrack --ctorigdstport 8080 --ctstate NEW -m recent --set --name PORT8080
    # -A DOCKER-USER -p tcp -m conntrack --ctorigdstport 8080 --ctstate NEW -m recent --update --seconds 30 --hitcount 6 --name PORT8080 -j DROP
    # -A DOCKER-USER -j RETURN
    log(f"{args=}", level=TRACE)
    log(f"command and remainder are: {args.command}, {' '.join(remainder)}", level=TRACE)
    try:
        rule = Rule.parse_rule_command(f"{args.command} {' '.join(remainder)}")
    except ValueError as e:
        log(f"ERROR: {e}", level=ERROR)
        return RULE_INVALID
    log(f"{rule.__dict__}", level=TRACE)
    new_rules,summary,check = process_rule(rule, args.config.default_in, args.config.default_out)
    if check != 0:
        return check
    # perform some checks and provide clarity to the user
    if rule.modification in ("", "insert", "prepend"): # if we're adding a new rule
        if rule != Rule.parse_rule_form(rule.print_rule_form()):
            log(f"{rule.__dict__=}\nvs\n{Rule.parse_rule_form(rule.print_rule_form()).__dict__=}", level=ERROR)
            log("ERROR: Internal consistency check failed!", level=ERROR)
            return INTERNAL_ERROR
        if rule.ipv_type == "6":
            log(f"ERROR: IPv6 is not supported by docker, therefore {PROGRAM_NAME} does not allow IPv6 addresses.", level=ERROR)
            return RULE_INVALID
        elif rule.ipv_type == "both":
            log(f"WARNING: IPv6 is not supported by docker, therefore the provided rule will only apply to IPv4.", level=WARNING)
        if rule.action:
            log(f"{rule.print_rule_ipt()}", level=TRACE)
    if not args.dry_run:
        if check := (confirm_root_and_chain() or write_rules_file(new_rules,summary)):
            return check
        return push_rules_to_iptables(args.config.default_in, args.config.default_out)
    else:
        print(new_rules, summary, sep="\n")
        return 0

