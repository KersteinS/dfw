def check_rule_form_parsing(rule: Rule):
    ruleform = rule.print_rule_form()
    log(rule.print_rule_form.__doc__, level=DEBUG)
    log(ruleform, level=DEBUG)
    rule_vars = vars(rule)
    rerule_vars = vars(Rule.parse_rule_form(ruleform))
    log(rerule_vars, level=DEBUG)
    failures = ""
    for key,val in rerule_vars.items():
        if key in rule_vars.keys() and rule_vars[key] == val:
            continue
        failures += f"{key}: {val}\n"
    if failures:
        raise ValueError(f"Rule vs Rerule not a match:\n{failures[:-1]}")

