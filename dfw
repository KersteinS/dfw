# To flush all DOCKER-USER chain rules: sudo iptables -F DOCKER-USER
# To list all DOCKER-USER chain rules: sudo iptables -L DOCKER-USER -n -v
# Commands to support:
# enable                          enables the firewall
# disable                         disables the firewall
# default ARG                     set default policy
# logging LEVEL                   set logging to LEVEL
# allow ARGS                      add allow rule
# deny ARGS                       add deny rule
# reject ARGS                     add reject rule
# limit ARGS                      add limit rule
# delete RULE|NUM                 delete RULE
# insert NUM RULE                 insert RULE at NUM
# prepend RULE                    prepend RULE
# route RULE                      add route RULE # route is not supported since the only chain managed by dfw is DOCKER-USER. There is no other traffic besides traffic being routed to DOCKER-USER
# route delete RULE|NUM           delete route RULE # route is not supported since the only chain managed by dfw is DOCKER-USER. There is no other traffic besides traffic being routed to DOCKER-USER
# route insert NUM RULE           insert route RULE at NUM # route is not supported since the only chain managed by dfw is DOCKER-USER. There is no other traffic besides traffic being routed to DOCKER-USER
# reload                          reload firewall
# reset                           reset firewall
# status                          show firewall status
# status numbered                 show firewall status as numbered list of RULES
# status verbose                  show verbose firewall status
# show ARG                        show firewall report
# version                         display version information

def to_base64(string: str) -> str:
    if not string:
        return ""
    return base64.urlsafe_b64encode(string.encode("utf-8")).decode("utf-8")

def from_base64(string: str) -> str:
    if not string:
        return ""
    try:
        return base64.urlsafe_b64decode(string.encode("utf-8")).decode("utf-8")
    except binascii.Error:
        log("Corrupted/Invalid encoded comment. Skipping", level=ERROR)
        return ""

def get_default_interface() -> str:
    with open("/proc/net/route") as file:
        for line in file.readlines():
            check = line.strip().split()
            if len(check) > 2 and check [1] == "00000000":
                log(f"detected {check[0]} as default interface", level=TRACE)
                return check[0]
class Config:

    default_config = (
        "# ENABLED: True|False\n"
        "ENABLED: False\n"
        "# DEFAULT_INCOMING: allow|deny|reject\n"
        "DEFAULT_INCOMING: deny\n"
        "# DEFAULT_OUTGOING: allow|deny|reject\n"
        "DEFAULT_OUTGOING: allow\n"
        "# LOG: on|off\n"
        "LOG: off\n"
        "# LOG_LEVEL: low|medium|high|full\n"
        "LOG_LEVEL: low\n"
        )

    def __init__(self, conf_string):
        self.initial_string = conf_string
        self._enabled = ""
        self._default_in = ""
        self._default_out = ""
        self._log = ""
        self._log_level = ""
        self._old_enabled = ""
        self._old_default_in = ""
        self._old_default_out = ""
        self._old_log = ""
        self._old_log_level = ""

    @property
    def enabled(self):
        return self._enabled

    @enabled.setter
    def enabled(self, value):
        errormsg = "Invalid value provided for config.enabled"
        if isinstance(value, str):
            if value == "False":
                self._old_enabled = self.enabled
                self._enabled = False
            elif value == "True":
                self._old_enabled = self.enabled
                self._enabled = True
            else:
                raise ValueError(errormsg)
        elif isinstance(value, bool):
            self._old_enabled = self.enabled
            self._enabled = value
        else:
            raise ValueError(errormsg)

    @property
    def default_in(self):
        return self._default_in

    @default_in.setter
    def default_in(self, value):
        if value not in ("allow", "deny", "reject"):
            raise ValueError("Invalid value provided for config.default_in")
        self._old_default_in = self._default_in
        self._default_in = value

    @property
    def default_out(self):
        return self._default_out

    @default_out.setter
    def default_out(self, value):
        if value not in ("allow", "deny", "reject"):
            raise ValueError("Invalid value provided for config.default_out")
        self._old_default_out = self._default_out
        self._default_out = value

    @property
    def log(self):
        return self._log

    @log.setter
    def log(self, value):
        errormsg = "Invalid value provided for config.log"
        if isinstance(value, str):
            if value == "off":
                self._old_log = self._log
                self._log = False
            elif value == "on":
                self._old_log = self._log
                self._log = True
            else:
                raise ValueError(errormsg)
        elif isinstance(value, bool):
            self._old_log = self._log
            self._log = value
        else:
            raise ValueError(errormsg)

    @property
    def log_level(self):
        return self._log_level

    @log_level.setter
    def log_level(self, value):
        if value in ("low", "medium", "high", "full"):
            self._old_log_level = self._log_level
            self._log_level = value
        else:
            raise ValueError("Invalid value provided for config.log_level")

    @classmethod
    def parse_config_str(cls, config_str) -> Self:
        new_config = Config(config_str)
        lines = [line for line in config_str.split("\n") if line and "#" not in line]
        valid_configs = {
                "ENABLED: ": ["False", "True"],
                "DEFAULT_INCOMING: ": ["deny", "allow", "reject"],
                "DEFAULT_OUTGOING: ": ["deny", "allow", "reject"],
                "LOG: ": ["off", "on"],
                "LOG_LEVEL: ": ["low", "medium", "high", "full"]
                }
        check_config_missing = [i[:-2] for i in valid_configs.keys()]
        configs_to_membernames = {"ENABLED: ": "_enabled", "DEFAULT_INCOMING: ": "_default_in", "DEFAULT_OUTGOING: ": "_default_out", "LOG: ": "_log", "LOG_LEVEL: ": "_log_level"}
        errormsg = "Invalid config line\n "
        for line in lines:
            matched_key = ""
            matched_value = ""
            if line.startswith("#"):
                continue
            for valid_key,valid_values in valid_configs.items():
                if line.startswith(valid_key):
                    parts = line.split(valid_key)
                    if len(parts) != 2 or parts[0] or parts[1] not in valid_values:
                        raise ValueError(f"{errormsg}{line}")
                    matched_key = valid_key
                    matched_value = parts[1]
                    if matched_value == "reject":
                        raise ValueError(f"{PROGRAM_NAME} does not currently support \"reject\"")
                    break
            else:
                raise ValueError(f"{errormsg}{line}")
            if new_config.__dict__[configs_to_membernames[matched_key]]:
                raise ValueError(f"Duplicate config line\n {line}")
            new_config.__dict__[configs_to_membernames[matched_key]] = matched_value
            check_config_missing.remove(matched_key[:-2])
        if check_config_missing:
            raise ValueError(f"Required setting(s) missing from {DFW_CONFIG_PATH}\n {', '.join(check_config_missing)}")
        else:
            return new_config

    def print_updated_config(self) -> str:
        old_membernames_to_configs = {"_old_enabled": "ENABLED: ", "_old_default_in": "DEFAULT_INCOMING: ", "_old_default_out": "DEFAULT_OUTGOING: ", "_old_log": "LOG: ", "_old_log_level": "LOG_LEVEL: "}
        current_config = self.initial_string.split("\n")
        for key,value in old_membernames_to_configs.items():
            if self.__dict__[key]:
                for index,line in enumerate(current_config):
                    if line.startswith(value):
                        current_config[index] = f"{value}{self.__dict__[key[4:]]}"
                        break
        return '\n'.join(current_config)

class Rule:
    # TODO All rules need DFW_COMMENT: sudo iptables -A INPUT -p tcp --dport 22 -j RETURN "

    comment = ""
    modification = ""
    insert_index = ""
    delete_index = ""
    action = ""
    direction = ""
    output_interface = ""
    input_interface = ""
    log = ""
    dapp = ""
    ipv_type = ""
    source_addr = ""
    dest_addr = ""
    sapp = ""
    sports = ""
    dports = ""
    protocol = ""

    def __eq__(self, other) -> bool:
        if not isinstance(other, Rule):
            return NotImplemented
        return (
                self.action == other.action
                and self.direction == other.direction
                and self.output_interface == other.output_interface
                and self.input_interface == other.input_interface
                and self.log == other.log
                and self.dapp == other.dapp
                and self.ipv_type == other.ipv_type
                and self.source_addr == other.source_addr
                and self.dest_addr == other.dest_addr
                and self.sapp == other.sapp
                and self.sports == other.sports
                and self.dports == other.dports
                and self.protocol == other.protocol
                )

    @staticmethod
    def check_ports(ports_str):
        ports = ports_str.split(",")
        if len(ports) + ports_str.count(":") > 15:
            log(f"{len(ports)=}, {ports_str.count(':')=}", level=TRACE)
            raise ValueError(f"Bad port \"{ports_str}\"")
        for i in ports:
            if not i:
                log(f"{ports=}", level=TRACE)
                raise ValueError(f"Bad port \"{ports_str}\"")
            if ":" in i:
                check = [j for j in i.split(":") if len(j) > 0 and 0 < int(j) < 65536]
                if len(check) != 2 or  int(check[0]) > int(check[1]):
                    log(f"{check=}", level=TRACE)
                    raise ValueError(f"Bad port \"{ports_str}\"")
                for j in range(int(check[0])+1, int(check[1])):
                    check.insert(-1, str(j))
            elif not 0 < int(i) < 65536:
                log(f"{i=}", level=TRACE)
                raise ValueError(f"Bad port \"{ports_str}\"")

    @staticmethod
    def is_valid_ipv4(address: str):
        try:
            ipaddress.IPv4Address(address)
            return True
        except (ipaddress.AddressValueError, ValueError):
            log(f"{address} is not a vlid IPv4 address. Checking if it's a valid IPv4 network", level=TRACE)
            # pass
        try:
            ipaddress.IPv4Network(address, strict=False)
            return True
        except (ipaddress.AddressValueError, ipaddress.NetmaskValueError, ValueError):
            return False
    
    @staticmethod
    def is_valid_ipv6(address: str):
        try:
            ipaddress.IPv6Address(address)
            return True
        except (ipaddress.AddressValueError, ValueError):
            log(f"{address} is not a vlid IPv6 address. Checking if it's a valid IPv6 network", level=TRACE)
            # pass
        try:
            ipaddress.IPv6Network(address, strict=False)
            return True
        except (ipaddress.AddressValueError, ipaddress.NetmaskValueError, ValueError):
            return False

    @staticmethod
    def determine_service_port(service_name) -> str:
        try:
            return str(socket.getservbyname(service_name))
        except OSError:
            log(f"{service_name=} does not have a matching entry in /etc/services", level=TRACE)
            return ""

    @staticmethod
    def determine_service_proto(service_name) -> str:
        proto = ""
        try:
            socket.getservbyname(service_name)
        except OSError:
            log(f"{service_name=} does not have a matching entry in /etc/services", level=TRACE)
            return ""
        try:
            socket.getservbyname(service_name, "tcp")
            proto = "tcp"
        except OSError:
            log(f"{service_name=} does not have a matching tcp entry in /etc/services", level=TRACE)
            # pass
        try:
            socket.getservbyname(service_name, "udp")
            if proto:
                proto = "both"
            else:
                proto = "udp"
        except OSError:
            log(f"{service_name=} does not have a matching udp entry in /etc/services", level=TRACE)
            # pass
        return proto

    @staticmethod
    def check_comment(comment: str):
        if "'" in comment:
            log(f"{comment=}", level=TRACE)
            raise ValueError("Comment may not contain \"'\"")

    @staticmethod
    def check_insert_index(index: str):
        if not index.isdigit() or int(index)==0:
            raise ValueError(f"Cannot insert rule at position \"{index}\"")

    @staticmethod
    def check_action(action: str):
        if not action.lower() in ("allow", "deny", "reject", "limit"):
            log(f"{action=}", level=TRACE)
            raise ValueError("Invalid Syntax")

    @staticmethod
    def check_interface(interface: str):
        if "!" in interface:
            log(f"{interface=}", level=TRACE)
            raise ValueError("Bad interface name: reserved character: \"!\"")
        elif ":" in interface:
            log(f"{interface=}", level=TRACE)
            raise ValueError("Bad interface name: can't use interface aliases")
        elif interface in (".", ".."):
            log(f"{interface=}", level=TRACE)
            raise ValueError("Bad interface name: can't use \".\" or \"..\"")
        elif len(interface) > 15:
            log(f"{interface=}", level=TRACE)
            raise ValueError("Bad interface name: interface name is too long")
        elif not all(char in ALPHANUMERIC+"_-.+,=%@" for char in interface):
            log(f"{interface=}", level=TRACE)
            raise ValueError("Bad interface name")

    @staticmethod
    def is_numeric_port(port: str) -> bool:
        return all(char in string.digits+":," for char in port) and port[-1].isdigit() and port[0].isdigit()

    @staticmethod
    def check_supported_proto(proto: str):
        if proto not in ("tcp", "udp", "ipv6", "esp", "ah", "esp", "gre", "igmp", "vrrp"):
            raise ValueError(f"Unsupported protocol \"{proto}\"")

    @staticmethod
    def check_valid_port_protocol(proto: str):
        if proto not in ("tcp", "udp"):
            raise ValueError(f"Invalid port with protocol {proto}")

    @staticmethod
    def determine_ipvtype(source: str, dest: str):
            if source == dest:
                return source
            elif "both" not in (source, dest):
                log(f"{source=}, {dest=}", level=TRACE)
                raise ValueError("Mixed IP versions for from and to")
            elif source != "both":
                return source
            else: # therefore dest != "both"
                return dest

    @classmethod
    def parse_rule_command(cls, raw_command: str) -> Self:
        # This takes a dfw command (e.g. allow 8080) and parses it into a Rule instance
        new_rule = Rule()
        is_advanced = False
        user_proto = ""
        user_dport = ""
        user_sport = ""
        to_service = ""
        from_service = ""
        cmd = raw_command.split()
        if len(cmd) < 2:
            log(f"{cmd=}, {len(cmd)=}", level=TRACE)
            raise ValueError("Invalid Syntax")
        if "comment" in cmd:
            loc = cmd.index("comment")
            if loc > len(cmd) - 2:
                log(f"{cmd=}, {len(cmd)=}", level=TRACE)
                raise ValueError("Option \"comment\" missing required argument")
            comment = cmd[loc+1:]
            if len(comment) < 2:
                check = comment[0]
            else:
                check = ' '.join(comment)
            cls.check_comment(check)
            new_rule.comment = to_base64(check)
            cmd = cmd[:loc] # discard "comment" and comment arg
        if cmd[0].lower() == "rule":
            cmd.pop(0)
        if len(cmd) < 2 or len(cmd) > 15:
            log(f"{cmd=}, {len(cmd)=}", level=TRACE)
            raise ValueError("Invalid Syntax")
        if cmd[0].lower() in ("prepend", "insert", "delete"):
            new_rule.modification = cmd.pop(0).lower()
        if new_rule.modification == "insert":
            if len(cmd) < 3:
                log(f"{cmd=}, {len(cmd)=}", level=TRACE)
                raise ValueError("Invalid Syntax")
            check = cmd.pop(0)
            cls.check_insert_index(check)
            new_rule.insert_index = check
        elif new_rule.modification == "delete":
            if len(cmd) == 1 and cmd[0].isdigit():
                new_rule.delete_index = cmd.pop(0)
                return new_rule
        if len(cmd) < 2:
            log(f"{cmd=}, {len(cmd)=}", level=TRACE)
            raise ValueError("Invalid Syntax")
        check = cmd.pop(0)
        cls.check_action(check)
        new_rule.action = check
        if len(cmd) < 1:
            log(f"{cmd=}, {len(cmd)=}", level=TRACE)
            raise ValueError("Invalid Syntax")
        if ("in" in cmd or "out" in cmd) and cmd[0].lower() not in ("in", "out"):
            raise ValueError("Invalid interface clause")
        elif "in" not in cmd and "out" not in cmd:
            new_rule.direction = "in"
        else:
            new_rule.direction = cmd.pop(0).lower()
            if len(cmd) < 1 or "in" in cmd or "out" in cmd:
                log(f"{cmd=}, {len(cmd)=}", level=TRACE)
                raise ValueError("Invalid interface clause")
            if cmd[0].lower() == "on":
                is_advanced = bool(cmd.pop(0)) # set is_advanced to True
                check = cmd.pop(0)
                cls.check_interface(check)
                if new_rule.direction == "out":
                    new_rule.output_interface = check
                else:
                    new_rule.input_interface = check
        # command could be done here. limit in on eth0
        if len(cmd) > 0:
            if cmd[0].lower() in ("log", "log-all") and len(cmd) > 1:
                new_rule.log = cmd.pop(0).lower()
            if "log" in cmd:
                raise ValueError("option \"log\" not allowed here")
            if "log-all" in cmd:
                raise ValueError("option \"log-all\" not allowed here")
        if len(cmd) == 1 and not is_advanced:
            # simple syntax, assumes direction is "in" (unless specified otherwise) and ports are dest ports or to_service/dapp
            if "/" in cmd[0]: # can't be an app if there's a /
                check = cmd[0].split("/")
                if len(check) != 2:# or not check[0] or not check[1]:
                    log(f"{cmd=}, {len(check)=}", level=TRACE)
                    raise ValueError("Bad port")
                user_port = check[0]
                user_proto = check[1]
            else:
                user_port = cmd[0]
            if user_proto:
                cls.check_supported_proto(user_proto)
                cls.check_valid_port_protocol(user_proto)
            if not user_port.isdigit() and user_port[0].isalnum() and all(char in ALPHANUMERIC+"_-.+" for char in user_port): # if True we're dealing with either a service or an application
                if user_proto == "": # if user proto is "" it could be either a service or application still
                    check = cls.determine_service_port(user_port)
                    if check:
                        to_service = user_port
                    elif user_port in cls.get_applications(): 
                        new_rule.dapp = user_port
                    else:
                        raise ValueError(f"Could not find a profile matching \"{user_port}\"")
                else: # it must be a service
                    check = cls.determine_service_port(user_port)
                    if check:
                        to_service = user_port
                    else:
                        log(f"{check=}, {len(check)=}", level=TRACE)
                        raise ValueError("Bad port")
            elif all(char in ALPHANUMERIC+",:" for char in user_port):
                if not cls.is_numeric_port(user_port):
                    log(f"{user_port=}", level=TRACE)
                    raise ValueError("Port ranges must be numeric")
                user_dport = user_port
            else:
                log(f"{user_port=}", level=TRACE)
                raise ValueError("Bad port")
            new_rule.ipv_type = "both"
        elif len(cmd) % 2 != 0:
            log(f"{cmd=}, {len(cmd)=}", level=TRACE)
            raise ValueError("Wrong number of arguments")
        elif "from" not in cmd and "to" not in cmd and not is_advanced:
            raise ValueError("Need \"to\" or \"from\" clause")
        else:
            # full syntax required
            # when using app in full syntax, ufw only refers to its applications.d configuration files 
            # and will not fall back on /etc/services. And when using port in full syntax, it can be either 
            # a port/port range or a service from /etc/services but not an app from applications.d.
            is_advanced = True
            valid_keys = ["proto", "from", "port", "app", "to"]
            key_dict = {
                    "proto": 0,
                    "from": 0,
                    "port": 0,
                    "app": 0,
                    "to": 0
                    }
            for i in cmd:
                if i in key_dict.keys():
                    key_dict[i] += 1
            if key_dict["proto"] > 1 or key_dict["from"] > 1 or key_dict["port"] > 2 or key_dict["app"] > 2 or key_dict["to"] > 1 or (key_dict["app"] > 0 and key_dict["proto"] > 0):
                log(f"{key_dict=}", level=TRACE)
                raise ValueError("Improper rule syntax")
            next_port_or_app = ""
            source_ipv_type = "both"
            dest_ipv_type = "both"
            while len(cmd) > 1:
                if cmd[0] not in valid_keys:
                    raise ValueError(f"Invalid token \"{cmd[0]}\"")
                elif cmd[0] == "proto":
                    del cmd[0] # discard "proto"
                    proto = cmd.pop(0) # retrieve proto value
                    cls.check_supported_proto(proto)
                    user_proto = proto
                elif cmd[0] in ("from", "to"):
                    direction = cmd.pop(0)
                    addr = cmd.pop(0)
                    ipv_type = ""
                    if addr == "any":
                        ipv_type = "both"
                    else:
                        if cls.is_valid_ipv4(addr):
                            ipv_type = "4"
                        elif cls.is_valid_ipv6(addr):
                            ipv_type = "6"
                        else:
                            log(f"{addr=}", level=TRACE)
                            addr_type = "source" if direction=="from" else "destination"
                            raise ValueError(f"Bad {addr_type} address")
                        if direction == "from":
                            new_rule.source_addr = addr
                        else:
                            new_rule.dest_addr = addr
                    if direction == "from":
                        source_ipv_type = ipv_type
                    else:
                        dest_ipv_type = ipv_type
                    if len(cmd) > 1 and cmd[0] in ("port", "app"): # look ahead for port or app
                        next_port_or_app = direction
                elif cmd[0] == "port" or cmd[0] == "app":
                    if next_port_or_app == "":
                        raise ValueError(f"Need \"from\" or \"to\" with \"{cmd[0]}\"")
                    key = cmd.pop(0)
                    value = cmd.pop(0)
                    if key == "app":
                        app = value
                        if next_port_or_app == "from":
                            new_rule.sapp = app
                        else:
                            new_rule.dapp = app
                        next_port_or_app = ""
                    else:
                        ports_str = value
                        ports = ports_str.split(",")
                        # value for port must be a service or port or port range. No / and protocol allowed.
                        if not cls.is_numeric_port(ports_str):
                            if "," in ports_str or ":" in ports_str:
                                log(f"{ports_str=} and cannot contain colon or comma", level=TRACE)
                                raise ValueError("Port ranges must be numeric")
                            if next_port_or_app == "from":
                                from_service = ports_str
                            else:
                                to_service = ports_str
                        elif next_port_or_app == "from":
                            user_sport = ports_str
                        else:
                            user_dport = ports_str
                        next_port_or_app = ""
            if user_proto and (user_dport != "" or user_sport != ""):
                cls.check_valid_port_protocol(user_proto)
            new_rule.ipv_type = cls.determine_ipvtype(source_ipv_type, dest_ipv_type)
        from_service_proto = "both"
        to_service_proto = "both"
        if user_sport:
            cls.check_ports(user_sport)
            new_rule.sports = user_sport
        elif from_service:
            new_rule.sports = cls.determine_service_port(from_service)
            if not new_rule.sports:
                raise ValueError(f"Bad port \"{from_service}\"")
            from_service_proto = cls.determine_service_proto(from_service)
            if from_service_proto != "both":
                cls.check_supported_proto(from_service_proto)
        if user_dport:
            try:
                cls.check_ports(user_dport)
                new_rule.dports = user_dport
            except ValueError:
                if not is_advanced:
                    raise ValueError("Bad port")
                else:
                    raise
        elif to_service:
            new_rule.dports = cls.determine_service_port(to_service)
            if not new_rule.dports and not is_advanced:
                raise ValueError("Bad port")
            elif not new_rule.dports:
                raise ValueError(f"Bad port \"{to_service}\"")
            to_service_proto = cls.determine_service_proto(to_service)
            if to_service_proto != "both":
                cls.check_supported_proto(to_service_proto)
        if to_service or from_service:
            if from_service_proto == to_service_proto:
                new_rule.protocol = from_service_proto
            elif "both" not in (from_service_proto, to_service_proto):
                log(f"{from_service_proto=}, {to_service_proto=}", level=TRACE)
                raise ValueError("Protocol mismatch (from/to)")
            elif from_service_proto != "both":
                new_rule.protocol = from_service_proto
            else: # therefore to_service_proto != "both"
                new_rule.protocol = to_service_proto
            if new_rule.protocol != "both" and user_proto and new_rule.protocol != user_proto:
                log(f"{new_rule.protocol=}, {user_proto=}", level=TRACE)
                raise ValueError(f"Protocol mismatch with specified protocol {user_proto}")
            elif new_rule.protocol == "both" and user_proto:
                new_rule.protocol = user_proto
        elif user_proto:
            new_rule.protocol = user_proto
        elif not is_advanced:
            new_rule.protocol = "both"
        else:
            new_rule.protocol = "any"
        if any(i in (":",",") for i in new_rule.sports+new_rule.dports):
            # multiple ports detected. Must specify tcp or udp explicitly
            if new_rule.protocol in ("any", "both"):
                log(f"{new_rule.protocol=}", level=TRACE)
                raise ValueError("Must specify \"tcp\" or \"udp\" with multiple ports")
            elif new_rule.protocol not in ("tcp", "udp"):
                log(f"{new_rule.protocol=}", level=TRACE)
                raise ValueError("Bad port")
        if new_rule.sapp or new_rule.dapp:
            log(f"{new_rule.sapp=}, {new_rule.dapp=}", level=TRACE)
            raise ValueError("Application Integration not currently supported") # TODO
        return new_rule

    def print_rule_form(self) -> str:
        """Form pattern: action[_logtype] protocol ipv_type source_addr source_ports dest_addr dest_ports [sapp dapp] direction[_interface] [comment]"""
        output = "[RULEFORM] "
        logtype = f"_{self.log}" if self.log else ""
        proto = "tcp/udp" if self.protocol == "both" else self.protocol
        ipv_type = f"ipv{self.ipv_type}" if self.ipv_type != "both" else "both"
        source_addr = self.source_addr if self.source_addr else "any"
        dest_addr = self.dest_addr if self.dest_addr else "any"
        sports = self.sports if self.sports else "any"
        dports = self.dports if self.dports else "any"
        sapp = ""
        dapp = ""
        if self.sapp or self.dapp:
            sapp = self.sapp.replace(" ", "%20") + " " if self.sapp else "- "
            dapp = self.dapp.replace(" ", "%20") + " " if self.dapp else "- "
        if self.direction == "out":
            direction_interface = f"out_{self.output_interface}" if self.output_interface else "out"
        else:
            direction_interface = f"in_{self.input_interface}" if self.input_interface else "in"
        comment = f"comment={self.comment}" if self.comment else ""
        output+=f"{self.action}{logtype} {proto} {ipv_type} {source_addr} {sports} {dest_addr} {dports} {sapp}{dapp}{direction_interface} {comment}"
        return output

    @classmethod
    def parse_rule_form(cls, form: str):
        """Form pattern: action[_logtype] protocol ipv_type source_addr source_ports dest_addr dest_ports [sapp dapp] direction[_interface] [comment]"""
        errormsg = f"Invalid RULEFORM: {form}"
        new_rule = Rule()
        parts = form.split()[1:] # immediately discard "[RULEFORM]"
        if not 7 < len(parts) < 12:
            log(f"{parts=}, {len(parts)=}", level=TRACE)
            raise ValueError(errormsg)
        if "comment=" in parts[-1]:
            new_rule.comment = parts.pop(-1).replace("comment=", "")
        if "_" in parts[0]:
            action,logtype = parts.pop(0).split("_")
        else:
            action,logtype = parts.pop(0),""
        try: 
            cls.check_action(action)
            new_rule.action = action
        except ValueError:
            log(f"{action=}", level=TRACE)
            raise ValueError(errormsg)
        if logtype not in ("", "log", "log-all"):
            log(f"{logtype=}", level=TRACE)
            raise ValueError(errormsg)
        if logtype:
            new_rule.log = logtype
        proto = parts.pop(0)
        if proto != "tcp/udp":
            if proto != "any":
                try:
                    cls.check_supported_proto(proto)
                except ValueError:
                    log(f"{proto=}", level=TRACE)
                    raise ValueError(errormsg)
            new_rule.protocol = proto
        else:
            new_rule.protocol = "both"
        ipv_type = parts.pop(0)
        if ipv_type not in ("both", "ipv4", "ipv6"):
            log(f"{ipv_type=}", level=TRACE)
            raise ValueError(errormsg)
        new_rule.ipv_type = ipv_type.replace("ipv", "")
        source_addr = parts.pop(0)
        if not (source_addr == "any" or cls.is_valid_ipv4(source_addr) or cls.is_valid_ipv6(source_addr)):
            log(f"{source_addr=}", level=TRACE)
            raise ValueError(errormsg)
        if source_addr != "any":
            new_rule.source_addr = source_addr
        source_ports = parts.pop(0)
        if source_ports != "any" and not cls.is_numeric_port(source_ports):
            log(f"{source_ports=}", level=TRACE)
            raise ValueError(errormsg)
        if source_ports != "any":
            new_rule.sports = source_ports
        dest_addr = parts.pop(0)
        if not (dest_addr == "any" or cls.is_valid_ipv4(dest_addr) or cls.is_valid_ipv6(dest_addr)):
            log(f"{dest_addr=}", level=TRACE)
            raise ValueError(errormsg)
        if dest_addr != "any":
            new_rule.dest_addr = dest_addr
        dest_ports = parts.pop(0)
        if dest_ports != "any" and not cls.is_numeric_port(dest_ports):
            log(f"{dest_ports=}", level=TRACE)
            raise ValueError(errormsg)
        elif dest_ports != "any":
            new_rule.dports = dest_ports
        if new_rule.protocol not in ("any","both") and (new_rule.sports or new_rule.dports):
            try:
                new_rule.check_valid_port_protocol(new_rule.protocol)
            except ValueError:
                log(f"{new_rule.protocol=}", level=TRACE)
                raise ValueError(errormsg)
        if len(parts) == 3:
            sapp = parts.pop(0)
            if sapp != "-":
                new_rule.sapp = sapp.replace("%20", " ")
            dapp = parts.pop(0)
            if dapp != "-":
                new_rule.dapp = dapp.replace("%20", " ")
        elif len(parts) == 1:
            if "_" in parts[0]:
                direction,interface = parts.pop(0).split("_")
            else:
                direction,interface = parts.pop(0),""
            if direction not in ("in", "out"):
                log(f"{direction=}", level=TRACE)
                raise ValueError(errormsg)
            new_rule.direction = direction
            if interface:
                try:
                    cls.check_interface(interface)
                except ValueError:
                    log(f"{interface=}", level=TRACE)
                    raise ValueError(errormsg)
                if direction == "out":
                    new_rule.output_interface = interface
                else:
                    new_rule.input_interface = interface
        else:
            raise ValueError(errormsg)
        return new_rule

    def print_rule_ipt(self, silent=False) -> str:
        # print the rule as iptables rule(s)
        if self.ipv_type == "6":
            rules = [f"-A {CHAIN6} "]
        else:
            rules = [f"-A {CHAIN} "]
        if self.direction == "out":
            rules[0] += "-o "
            if self.output_interface:
                rules[0] += f"{self.output_interface} "
            else:
                rules[0] += f"{DEFAULT_IFACE} "
                if not silent:
                    log(f"No output interface was provided (no \"on\" clause). Due to the implementation of the DOCKER-USER chain, the default interface to the internet ({DEFAULT_IFACE}) has been provisioned for this rule.", level=WARNING)
        else:
            rules[0] += "-i "
            if self.input_interface:
                rules[0] += f"{self.input_interface} "
            else:
                rules[0] += f"{DEFAULT_IFACE} "
                if not silent:
                    log(f"No input interface was provided (no \"on\" clause). Due to the implementation of the DOCKER-USER chain, the default interface to the internet ({DEFAULT_IFACE}) has been provisioned for this rule", level=WARNING)
        rules[0] += "-m conntrack --ctdir ORIGINAL "
        if self.source_addr and self.source_addr != "any":
            rules[0] += f"--ctorigsrc {self.source_addr} "
        if self.dest_addr and self.dest_addr != "any":
            rules[0] += f"--ctorigdst {self.dest_addr} "
        if self.sports:
            if "," not in self.sports:
                rules[0] += f"--ctorigsrcport {self.sports} "
            else:
                raise ValueError("ctorigsrcport does not support csv for port ranges, only ranges using colon (:)")
        if self.dports:
            if "," not in self.dports:
                rules[0] += f"--ctorigdstport {self.dports} "
            else:
                raise ValueError("ctorigdstport does not support csv for port ranges, only ranges using colon (:)")
        if self.protocol == "both":
            rules.append(rules[0])
            rules[0] += "-p tcp "
            rules[1] += "-p udp "
        elif self.protocol != "any":
            rules[0] += f"-p {self.protocol} "
        if self.action == "allow":
            action = "-j RETURN"
        elif self.action == "deny":
            action = "-j DROP"
        elif self.action == "reject":
            action = "-j REJECT"
        elif self.action == "limit":
            raise ValueError("limit action not implemented yet")
        for i in range(len(rules)):
            rules[i] += f"{action} {RULE_COMMENT}"
        if self.ipv_type == "both" and False: # Delete and False to re-enable IPv6. At this time there is no IPv6 DOCKER-USER chain.
            rules.append(rules[0].replace(CHAIN, CHAIN6))
            if len(rules) == 3:
                rules.append(rules[1].replace(CHAIN, CHAIN6))
        return '\n'.join(f"{i}" for i in rules)

    def print_rule_dfw(self) -> str:
        # print the rule as it was entered in ufw-like syntax
        is_advanced = bool(self.input_interface or self.output_interface or self.source_addr or self.sports or self.dest_addr)
        action = self.action
        direction = self.direction
        if is_advanced:
            from_clause = ""
            to_clause = ""
            interface = self.input_interface if self.input_interface else self.output_interface
            if self.source_addr or self.sports:
                from_clause = f" from {self.source_addr if self.source_addr else 'any'}{' port '+self.sports if self.sports else ''}"
                if self.sapp:
                    from_clause += f" app {self.sapp}"
            if self.dest_addr or self.dports or not self.dest_addr and not self.dports:
                to_clause = f" to {self.dest_addr if self.dest_addr else 'any'}{' port '+self.dports if self.dports else ''}"
                if self.dapp:
                    to_clause += f" app {self.dapp}"
            return f"{self.action} {self.direction}{'on '+interface if interface else ''}{self.log+' ' if self.log else ''}{from_clause}{to_clause} {'proto '+self.protocol if self.protocol not in ('both', 'any', '') else ''}"
        else:
            port_proto = self.dports
            if self.protocol in ("tcp", "udp"):
                port_proto += f"/{self.protocol}"
            return f"{self.action} {self.direction} {self.log+' ' if self.log else ''}{port_proto}"

