def read_rules_file() -> (list[str], int):
    try:
        with open(DFW_RULES_PATH, "r") as rules_file:
            rules_list = rules_file.readlines()
        log("Read rules file successfully", level=TRACE)
        return rules_list, 0
    except FileNotFoundError:
        log(f"Reading {DFW_RULES_PATH} failed due to missing file. Aborting!", level=CRITICAL)
        return [], FILE_MISSING

def write_rules_file(content: list[str]) -> int:
    try:
        shutil.copy2(DFW_RULES_PATH, DFW_RULES_PATH+".bak")
        log("Made backup of dfw.rules.", level=INFO)
        if not os.path.exists(DFW_RULES_PATH+".original"):
                shutil.copy2(DFW_RULES_PATH, DFW_RULES_PATH+".original")
                log("Made backup of original after.rules", INFO)
                return 0
    except FileNotFoundError:
        log(f"Couldn't back up {DFW_RULES_PATH} due to missing file. Aborting!", level=CRITICAL)
        return FILE_MISSING
    try:
        with open(DFW_RULES_PATH, "w") as rules_file:
            rules_file.writelines(content)
        log("Wrote to after.rules.", level=TRACE)
    except FileNotFoundError:
        log(f"Couldn't write {DFW_RULES_PATH} due to missing file. Aborting!", level=CRITICAL)
        return FILE_MISSING

