def read_rules_file() -> (list[str], int):
    rules_list = []
    try:
        with open(DFW_RULES_PATH, "r") as rules_file:
            for line in rules_file.readlines():
                if line.startswith("[RULEFORM]"):
                    rules_list.append(line)
        log("Read rules file successfully", level=TRACE)
        return rules_list, 0
    except FileNotFoundError:
        log(f"Reading {DFW_RULES_PATH} failed due to missing file. Aborting!", level=CRITICAL)
        return [], FILE_MISSING

def write_rules_file(content: str, action: str) -> int:
    # rules should only consist of [RULEFORM]s and the associated iptable rule(s) for each form. The initial few lines of dfw.rules never change (store these in code), and the final line is determined by the value of default in dfw.conf.
    try:
        shutil.copy2(DFW_RULES_PATH, DFW_RULES_PATH+".bak")
        log("Made backup of dfw.rules.", level=DEBUG)
    except FileNotFoundError:
        log(f"Couldn't back up {DFW_RULES_PATH} due to missing file. Aborting!", level=CRITICAL)
        return FILE_MISSING
    with open(DFW_RULES_PATH, "w") as rules_file:
        rules_file.writelines(content)
    log("Wrote to dfw.rules.", level=DEBUG)
    print(action)

def request_confirmation(prompt: str) -> bool:
    while True:
        check = input(f"{prompt}\nProceed with operation (y|n)? ")
        if check.lower() == "y":
            return True
        elif check.lower() == "n":
            return False

def process_rule(new_rule: Rule, default="deny") -> (str,str,int):
    rules_str_list,check = read_rules_file()
    if check != 0:
        return "","",check
    rules = []
    for rule_str in rules_str_list:
        try:
            rule = Rule.parse_rule_form(rule_str)
        except ValueError as e:
            log(f"ERROR: {e} in {DFW_RULES_PATH}", level=ERROR)
            return "","",RULE_INVALID
        rules.append(rule)
    if new_rule.modification == "delete":
        if new_rule.delete_index:
            index = int(new_rule.delete_index)
            if len(rules) < 1 or len(rules) < index:
                log("Invalid rule index", level=ERROR)
                return "","",RULE_INVALID
            if request_confirmation(f"Deleting:\n {rules[index-1].print_rule_dfw()}") == True:
                del rules[index-1]
            else:
                return "","",CONFIRMATION_DENIED
        else:
            index = None
            check_vs = new_rule.print_rule_form()
            for i,rule in enumerate(rules):
                if check_vs == rule.print_rule_form():
                    index = i
                    break
            else:
                log("No rule matched input", level=ERROR)
                return "","",RULE_INVALID
            if request_confirmation(f"Deleting:\n {rules[index].print_rule_dfw()}") == True:
                del rules[index]
            else:
                return "","",CONFIRMATION_DENIED
        summary = "Rule deleted"
    elif new_rule.modification in ("insert","prepend"):
        index = 0 if new_rule.modification == "prepend" else int(new_rule.insert_index)
        rules.insert(index-1, new_rule)
        summary = "Rule added"
    else:
        check_vs = new_rule.print_rule_form()
        for i,rule in enumerate(rules):
            if check_vs == rule.print_rule_form():
                index = i
                log("Skipping adding existing rule", level=WARNING)
                return "","",RULE_INVALID
        rules.append(new_rule)
        summary = "Rule added"
    content = (
        f"# generated by {PROGRAM_NAME} version {VERSION}. Default={default}\n"
        f"{RULES_HEAD}\n"
        + '\n\n'.join(f"{rule.print_rule_form()}\n{rule.print_rule_ipt(True)}" for rule in rules)
        + (f"\n\n{RULES_TAIL_DENY}\n" if default=="deny" else f"\n\n{RULES_TAIL_ALLOW}\n")
    )
    return content,summary,0

